                    <span class="price-amount" id="prix-copywriting">22</span>
                    <span class="price-period">€/h</span>
                    <span class="tax-label" id="label-copywriting">(HT)</span>
                </div>
                <a href="{% if session.id is defined %}index.php?page=devis&type=copywriting{% else %}index.php?page=connexion&redirect=devis&type=copywriting{% endif %}" class="service-cta service-cta-primary">
                    <i class="fas fa-paper-plane"></i> Demander un Devis
                </a>
            </div>
        </div>
    </div>

           {# Service 4: Montage PC 
        <div class="service-card animate__animated animate__fadeInUp" style="animation-delay: 0.1s;">

{% extends 'base.twig' %}

{% block title %}Nos Services Innovants - Le Design Du Web{% endblock %}

{% block head %}
    {{ parent() }}
    <script src="{{ get_asset_url('/public/js/react/devisApp.bundle.js', true) }}" defer></script>
    <style>
        /* ============================================== */
        /* STYLES PAGE SERVICES (REFONTE V4 - 2025)      */
        /* ============================================== */

        /* --- Background & Container Styles --- */
        .services-hero {
            position: relative;
            background: linear-gradient(180deg, 
                        rgba(var(--violet-principal-rgb), 0.03) 0%, 
                        rgba(var(--violet-principal-rgb), 0.01) 100%);
            overflow: hidden;
            padding: 4rem 1rem;
            margin-top: -2rem; /* Compense le padding du container */
            margin-bottom: 2rem;
            text-align: center;
        }
        
        /* Effet de particules sur l'arrière-plan */
        .services-hero::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            right: -50%;
            bottom: -50%;
            background-image: 
                radial-gradient(circle at 20% 35%, rgba(var(--violet-principal-rgb), 0.07) 0%, transparent 50%),
                radial-gradient(circle at 75% 44%, rgba(var(--violet-accent-rgb), 0.05) 0%, transparent 40%);
            z-index: 0;
            pointer-events: none;
        }
        
        .services-page-container {
            position: relative;
            padding-top: 1px; /* Empêche margin collapse */
            padding-bottom: 3rem;
        }
        
        /* Effet lignes de grille sur l'arrière-plan */
        .services-page-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: linear-gradient(to right, rgba(var(--violet-principal-rgb), 0.03) 1px, transparent 1px),
                              linear-gradient(to bottom, rgba(var(--violet-principal-rgb), 0.03) 1px, transparent 1px);
            background-size: 30px 30px;
            z-index: -1;
            pointer-events: none;
        }

        /* --- Header & Text Styles --- */
        .hero-subtitle {
            color: var(--violet-accent);
            font-weight: 600;
            font-size: 1.1rem;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            margin-bottom: 1rem;
            display: inline-block;
            position: relative;
            padding: 0.5rem 1.5rem;
            background: rgba(var(--violet-principal-rgb), 0.08);
            border-radius: 50px;
            z-index: 1;
        }
        
        .hero-title {
            color: var(--texte-couleur);
            font-weight: 800;
            font-size: clamp(2.5rem, 7vw, 3.5rem);
            margin-bottom: 1.5rem;
            line-height: 1.2;
            position: relative;
        }
        
        /* Effet de soulignement stylisé */
        .hero-title span {
            position: relative;
            z-index: 1;
            white-space: nowrap;
        }
        
        .hero-title span::after {
            content: '';
            position: absolute;
            bottom: 0.2rem;
            left: 0;
            height: 0.4rem;
            width: 100%;
            background: linear-gradient(90deg, var(--violet-principal), var(--violet-accent));
            z-index: -1;
            opacity: 0.3;
            border-radius: 4px;
        }
        
        .hero-description {
            color: var(--texte-secondaire);
            font-size: 1.25rem;
            max-width: 800px;
            margin: 0 auto 2rem;
            line-height: 1.8;
            position: relative;
            z-index: 1;
        }
        
        /* Séparateur décoratif */
        .fancy-divider {
            height: 5px;
            width: 80px;
            margin: 2rem auto;
            background: linear-gradient(90deg, var(--violet-principal), var(--violet-accent));
            border-radius: 5px;
        }
        
        .section-title {
            text-align: center;
            margin-bottom: 3rem;
            position: relative;
            padding-bottom: 1rem;
        }
        
        .section-title h2 {
            color: var(--texte-couleur);
            font-weight: 700;
            font-size: 2.2rem;
            margin-bottom: 1rem;
        }
        
        .section-title p {
            color: var(--texte-secondaire);
            max-width: 700px;
            margin: 0 auto;
            font-size: 1.1rem;
        }

        /* --- Service Card Styles (V4) --- */
        .service-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin-top: 2rem;
        }
        
        .service-card {
            background-color: var(--fond-secondaire);
            border-radius: 20px;
            overflow: hidden;
            position: relative;
            display: flex;
            flex-direction: column;
            height: 100%;
            box-shadow: 0 10px 30px rgba(var(--violet-principal-rgb), 0.08);
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), 
                        box-shadow 0.4s ease;
            border: 1px solid rgba(var(--bordure-couleur), 0.5);
        }
        
        .service-card:hover {
            transform: translateY(-15px);
            box-shadow: 0 20px 40px rgba(var(--violet-principal-rgb), 0.15);
        }
        
        /* Effet de lueur en bordure au survol */
        .service-card::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: inherit;
            padding: 2px;
            background: linear-gradient(135deg, var(--violet-principal), var(--violet-accent), transparent 60%);
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            opacity: 0;
            transition: opacity 0.4s ease;
        }
        
        .service-card:hover::before {
            opacity: 1;
        }
        
        .service-card-header {
            position: relative;
            padding: 2rem 2rem 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        
        .service-icon-container {
            width: 80px;
            height: 80px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 20px;
            background: linear-gradient(135deg, rgba(var(--violet-principal-rgb), 0.15), rgba(var(--violet-accent-rgb), 0.05));
            transition: transform 0.4s cubic-bezier(0.68, -0.55, 0.27, 1.55);
            position: relative;
            overflow: hidden;
        }
        
        /* Effet brillant sur l'icône */
        .service-icon-container::after {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
            transform: translateX(-100%);
            animation: shimmer 3s infinite;
        }
        
        @keyframes shimmer {
            0% { transform: translateX(-100%); }
            20%, 100% { transform: translateX(100%); }
        }
        
        .service-card:hover .service-icon-container {
            transform: scale(1.15) rotate(-10deg);
        }
        
        .service-icon {
            font-size: 2.8rem;
            color: var(--violet-principal);
            z-index: 2;
            transition: color 0.4s ease;
        }
        
        .service-card:hover .service-icon {
            color: var(--violet-accent);
        }
        
        .service-badge {
            background: rgba(var(--violet-principal-rgb), 0.1);
            color: var(--violet-accent);
            font-size: 0.85rem;
            font-weight: 600;
            padding: 0.5rem 1rem;
            border-radius: 50px;
            display: inline-block;
        }
        
        .service-card-body {
            padding: 1.5rem 2rem 2rem;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
        }
        
        .service-title {
            color: var(--texte-couleur);
            font-weight: 700;
            font-size: 1.75rem;
            margin-bottom: 1rem;
            transition: color 0.3s ease;
        }
        
        .service-card:hover .service-title {
            color: var(--violet-accent);
        }
        
        .service-description {
            color: var(--texte-secondaire);
            font-size: 1rem;
            line-height: 1.8;
            margin-bottom: 1.5rem;
        }
        
        /* Liste des caractéristiques avec animation */
        .service-features {
            margin: 1.5rem 0;
            padding: 0;
            list-style: none;
        }
        
        .service-features li {
            position: relative;
            padding-left: 1.8rem;
            margin-bottom: 0.75rem;
            color: var(--texte-secondaire);
            transform: translateY(0);
            opacity: 1;
            transition: transform 0.3s ease, opacity 0.3s ease;
        }
        
        .service-features li:before {
            content: '';
            position: absolute;
            left: 0;
            top: 0.5rem;
            width: 18px;
            height: 18px;
            background-color: rgba(var(--violet-principal-rgb), 0.1);
            border-radius: 50%;
            transition: background-color 0.3s ease;
        }
        
        .service-features li:after {
            content: '\f00c';
            font-family: 'Font Awesome 5 Free';
            font-weight: 900;
            font-size: 0.7rem;
            position: absolute;
            left: 5px;
            top: 0.5rem;
            color: var(--violet-accent);
        }
        
        .service-card:hover .service-features li {
            transform: translateY(-3px);
            opacity: 0.9;
        }
        
        .service-card:hover .service-features li:before {
            background-color: rgba(var(--violet-principal-rgb), 0.2);
        }
        
        /* Animation délai pour chaque élément de la liste */
        .service-card:hover .service-features li:nth-child(1) {
            transition-delay: 0.05s;
        }
        
        .service-card:hover .service-features li:nth-child(2) {
            transition-delay: 0.1s;
        }
        
        .service-card:hover .service-features li:nth-child(3) {
            transition-delay: 0.15s;
        }
        
        .service-card:hover .service-features li:nth-child(4) {
            transition-delay: 0.2s;
        }

        /* Section prix et bouton */
        .service-card-footer {
            padding: 0 2rem 2rem;
            display: flex;
            flex-direction: column;
            margin-top: auto;
        }
        
        .service-price {
            display: flex;
            align-items: baseline;
            margin-bottom: 1.5rem;
            color: var(--texte-secondaire);
            font-size: 1rem;
        }
        
        .price-amount {
            color: var(--violet-accent);
            font-size: 2.5rem;
            font-weight: 800;
            line-height: 1;
            margin-right: 0.5rem;
        }
        
        .price-period {
            color: var(--texte-secondaire);
            font-size: 1rem;
        }
        
        .tax-label {
            margin-left: auto;
            color: var(--texte-mute);
            font-size: 0.9rem;
        }
        
        .service-cta {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem 1.5rem;
            border-radius: 12px;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s ease;
            text-decoration: none;
            position: relative;
            overflow: hidden;
            width: 100%;
        }
        
        .service-cta i {
            margin-right: 0.75rem;
            transition: transform 0.3s ease;
        }
        
        .service-cta:hover i {
            transform: translateX(3px);
        }
        
        /* Effet d'ondulation au clic */
        .service-cta::after {
            content: '';
            position: absolute;
            width: 100px;
            height: 100px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 50%;
            transform: scale(0);
            opacity: 0;
            transition: transform 0.5s, opacity 0.5s;
        }
        
        .service-cta:active::after {
            transform: scale(3);
            opacity: 0;
            transition: 0s;
        }
        
        .service-cta-primary {
            background: linear-gradient(135deg, var(--violet-principal), var(--violet-secondaire));
            color: white;
            box-shadow: 0 5px 15px rgba(var(--violet-principal-rgb), 0.3);
        }
        
        .service-cta-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(var(--violet-principal-rgb), 0.4);
        }
        
        .service-cta-secondary {
            background: transparent;
            color: var(--violet-accent);
            border: 2px solid var(--violet-accent);
        }
        
        .service-cta-secondary:hover {
            background-color: rgba(var(--violet-principal-rgb), 0.05);
            transform: translateY(-3px);
        }

        /* Toggle Switch (pas de changement majeur nécessaire) */
        /* ... styles .toggle-container, .toggle-switch, .slider ... */
         .toggle-container { display: flex; justify-content: center; align-items: center; margin-top: 4rem; padding: 1.2rem; background-color: var(--fond-secondaire); border-radius: 0.75rem; gap: 1rem; color: var(--texte-secondaire); font-weight: 500; border: 1px solid var(--bordure-couleur); box-shadow: 0 4px 10px var(--ombre-couleur); }
         .toggle-switch { position: relative; display: inline-block; width: 60px; height: 34px; }
         .toggle-switch input { opacity: 0; width: 0; height: 0; }
         .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--fond-tertiaire); border: 1px solid var(--bordure-couleur); transition: .4s; border-radius: 34px; }
         .slider:before { position: absolute; content: ""; height: 26px; width: 26px; left: 3px; bottom: 3px; background-color: var(--texte-mute); transition: .4s; border-radius: 50%; }
         input:checked + .slider { background-color: var(--violet-principal); border-color: var(--violet-principal); }
         input:focus + .slider { box-shadow: 0 0 0 3px rgba(var(--violet-principal-rgb), 0.25); } /* Focus visible */
         input:checked + .slider:before { transform: translateX(26px); background-color: var(--white); }
         .toggle-container label { transition: color 0.3s ease, font-weight 0.3s ease; }
         .toggle-container label.active { color: var(--violet-accent); font-weight: 700; }
         
         /* Styles pour la carte de devis */
         .bg-gradient-purple {
             background: linear-gradient(135deg, var(--violet-principal), var(--violet-secondaire));
             border: none;
             border-radius: 1rem;
             box-shadow: 0 10px 25px rgba(var(--violet-principal-rgb), 0.3);
             overflow: hidden;
             position: relative;
         }
         
         .bg-gradient-purple::before {
             content: '';
             position: absolute;
             top: -50%;
             left: -50%;
             width: 200%;
             height: 200%;
             background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 60%);
             opacity: 0.6;
             z-index: 0;
         }
         
         .bg-gradient-purple .card-body {
             position: relative;
             z-index: 1;
         }
         
         .text-white-50 {
             color: rgba(255, 255, 255, 0.8) !important;
         }


    </style>
{% endblock %}

{% block body %}
<div class="services-hero">
    <div class="container">
        <div class="hero-subtitle animate__animated animate__fadeInUp">Expertise Technologique</div>
        <h1 class="hero-title animate__animated animate__fadeInUp" style="animation-delay: 0.1s;">

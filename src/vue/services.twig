{% block scripts %}
    {{ parent() }}
    <script>
        // Script amélioré pour le toggle HT/TTC avec animation
        document.addEventListener('DOMContentLoaded', function () {
            const toggle = document.getElementById('toggle-prix');
            const prices = {
                dev: { ht: 18, element: document.getElementById('prix-dev'), label: document.getElementById('label-dev') },
                montage: { ht: 20, element: document.getElementById('prix-montage'), label: document.getElementById('label-montage') },
                copywriting: { ht: 22, element: document.getElementById('prix-copywriting'), label: document.getElementById('label-copywriting') },
                seo: { ht: 25, element: document.getElementById('prix-seo'), label: document.getElementById('label-seo') }
            };
            const labelHT = document.getElementById('label-ht');
            const labelTTC = document.getElementById('label-ttc');
            const tvaRate = 1.20;

            // Animation de compteur pour les prix
            function animateValue(element, start, end, duration) {
                let startTimestamp = null;
                const step = (timestamp) => {
                    if (!startTimestamp) startTimestamp = timestamp;
                    const progress = Math.min((timestamp - startTimestamp) / duration, 1);
                    const currentValue = Math.floor(progress * (end - start) + start);
                    element.textContent = currentValue;
                    if (progress < 1) {
                        window.requestAnimationFrame(step);
                    } else {
                        element.textContent = end; // Assurez-vous d'atteindre exactement la valeur finale
                    }
                };
                window.requestAnimationFrame(step);
            }

            function updatePrices() {
                const isTTC = toggle.checked;
                
                // Animation des labels
                labelHT.classList.toggle('active', !isTTC);
                labelTTC.classList.toggle('active', isTTC);

                for (const key in prices) {
                    const service = prices[key];
                    if (service.element && service.label) {
                        let currentPrice = parseFloat(service.element.textContent.replace(',', '.'));
                        let targetPrice;
                        
                        if (isTTC) {
                            targetPrice = Math.round(service.ht * tvaRate * 100) / 100;
                            service.label.textContent = '(TTC)';
                        } else {
                            targetPrice = service.ht;
                            service.label.textContent = '(HT)';
                        }
                        
                        // Animation du prix
                        animateValue(service.element, Math.round(currentPrice), Math.round(targetPrice), 500);
                        
                        // Si le prix final contient des décimales (seulement en TTC)
                        if (isTTC && targetPrice % 1 !== 0) {
                            setTimeout(() => {
                                service.element.textContent = targetPrice.toFixed(2).replace('.', ',');
                            }, 550);
                        }
                    }
                }
            }

            toggle.addEventListener('change', updatePrices);
            updatePrices(); // Initialisation

            // Animation de surbrillance au survol
            document.querySelectorAll('.service-card').forEach(card => {
                card.addEventListener('mouseenter', function() {
                    const iconContainer = this.querySelector('.service-icon-container');
                    if (iconContainer) {
                        iconContainer.style.transform = 'scale(1.15) rotate(-10deg)';
                    }
                });
                
                card.addEventListener('mouseleave', function() {
                    const iconContainer = this.querySelector('.service-icon-container');
                    if (iconContainer) {
                        iconContainer.style.transform = '';
                    }
                });
                
                // Support tactile et clavier (accessibilité)
                card.addEventListener('focusin', function() {
                    this.classList.add('focus-within');
                });
                
                card.addEventListener('focusout', function() {
                    this.classList.remove('focus-within');
                });
            });
        });
    </script>
{% endblock %}

{% extends "client/base-client.twig" %}

{% block client_title %}Mes adresses{% endblock %}

{% block client_actions %}
<button type="button" class="btn btn-purple" data-bs-toggle="modal" data-bs-target="#addAddressModal">
    <i class="fas fa-plus-circle me-2"></i> Ajouter une adresse
</button>
{% endblock %}

{% block client_content %}
    <div class="client-card mb-4">
        <div class="card-header">
            <i class="fas fa-map-marker-alt me-2"></i> Mes adresses enregistrées
        </div>
        <div class="card-body">
            <p class="text-muted mb-4">
                Gérez vos adresses de livraison et de facturation pour faciliter vos prochaines commandes. 
                L'adresse définie par défaut sera automatiquement sélectionnée lors de votre passage en caisse.
            </p>

            {% if adresses|length > 0 %}
                <div class="row g-4">
                    {% for adresse in adresses %}
                        <div class="col-lg-6">
                            <div class="address-card {% if adresse.is_default %}default{% endif %}">
                                {% if adresse.is_default %}
                                    <span class="default-badge">Adresse par défaut</span>
                                {% endif %}
                                <div class="address-type">
                                    {% if adresse.type == 'livraison' %}
                                        <i class="fas fa-truck me-1"></i> Adresse de livraison
                                    {% elseif adresse.type == 'facturation' %}
                                        <i class="fas fa-file-invoice me-1"></i> Adresse de facturation
                                    {% else %}
                                        <i class="fas fa-map-marker-alt me-1"></i> Adresse
                                    {% endif %}
                                </div>
                                <address>
                                    <strong>{{ adresse.nom }}</strong><br>
                                    {{ adresse.rue }}<br>
                                    {{ adresse.code_postal }} {{ adresse.ville }}<br>
                                    {{ adresse.pays|default('France') }}<br>
                                    {% if adresse.telephone %}
                                        <i class="fas fa-phone-alt text-muted me-1 mt-2"></i> {{ adresse.telephone }}
                                    {% endif %}
                                </address>
                                <div class="address-actions">
                                    <button type="button" class="btn btn-sm btn-outline-purple" 
                                        data-bs-toggle="modal" data-bs-target="#editAddressModal{{ adresse.id }}">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    {% if not adresse.is_default %}
                                        <form action="index.php?page=adresses" method="post" class="d-inline">
                                            <input type="hidden" name="id_adresse" value="{{ adresse.id }}">
                                            <button type="submit" class="btn btn-sm btn-outline-primary" name="definir_defaut">
                                                <i class="fas fa-check"></i>
                                            </button>
                                        </form>
                                    {% endif %}
                                    <button type="button" class="btn btn-sm btn-outline-danger" 
                                        data-bs-toggle="modal" data-bs-target="#deleteAddressModal{{ adresse.id }}">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="fas fa-map-marker-alt fa-3x text-muted"></i>
                    </div>
                    <h5>Vous n'avez pas encore d'adresse enregistrée</h5>
                    <p class="text-muted mb-4">Ajoutez votre première adresse pour accélérer vos futures commandes.</p>
                    <button type="button" class="btn btn-purple" data-bs-toggle="modal" data-bs-target="#addAddressModal">
                        <i class="fas fa-plus-circle me-2"></i> Ajouter ma première adresse
                    </button>
                </div>
            {% endif %}
        </div>
    </div>

    <!-- Conseils d'utilisation -->
    <div class="client-card">
        <div class="card-header">
            <i class="fas fa-info-circle me-2"></i> Conseils et informations
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h5 class="mb-3"><i class="fas fa-lightbulb text-warning me-2"></i> Conseils pratiques</h5>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item border-0 ps-0">
                            <i class="fas fa-check-circle text-success me-2"></i> 
                            Désignez une adresse par défaut pour gagner du temps lors du passage de commande.
                        </li>
                        <li class="list-group-item border-0 ps-0">
                            <i class="fas fa-check-circle text-success me-2"></i> 
                            Utilisez un nom explicite pour chaque adresse (ex: "Domicile", "Bureau") pour les identifier facilement.
                        </li>
                        <li class="list-group-item border-0 ps-0">
                            <i class="fas fa-check-circle text-success me-2"></i> 
                            Pensez à mettre à jour vos adresses en cas de déménagement.
                        </li>
                    </ul>
                </div>
                <div class="col-md-6">
                    <h5 class="mb-3"><i class="fas fa-shield-alt text-primary me-2"></i> Sécurité des données</h5>
                    <p>
                        Vos adresses sont stockées de manière sécurisée conformément à notre 
                        <a href="#">politique de confidentialité</a> et ne sont jamais partagées avec des tiers.
                    </p>
                    <p>
                        Pour toute question concernant vos données personnelles, contactez notre délégué à la protection 
                        des données à <a href="mailto:privacy@ldw.fr">privacy@ldw.fr</a>.
                    </p>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block client_modals %}
    <!-- Modal ajout adresse -->
    <div class="modal fade" id="addAddressModal" tabindex="-1" aria-labelledby="addAddressModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="index.php?page=adresses" method="post">
                    <div class="modal-header">
                        <h5 class="modal-title" id="addAddressModalLabel">Ajouter une adresse</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="nom_adresse" class="form-label">Nom de l'adresse</label>
                            <input type="text" class="form-control" id="nom_adresse" name="nom_adresse" placeholder="Ex: Mon domicile, Bureau, etc." required>
                        </div>
                        <div class="mb-3">
                            <label for="type_adresse" class="form-label">Type d'adresse</label>
                            <select class="form-select" id="type_adresse" name="type_adresse" required>
                                <option value="livraison">Adresse de livraison</option>
                                <option value="facturation">Adresse de facturation</option>
                                <option value="les_deux">Livraison et facturation</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="nom_complet" class="form-label">Nom complet</label>
                            <input type="text" class="form-control" id="nom_complet" name="nom_complet" value="{{ client.prenom }} {{ client.nom }}" required>
                        </div>
                        <div class="mb-3">
                            <label for="rue" class="form-label">Rue et numéro</label>
                            <input type="text" class="form-control" id="rue" name="rue" placeholder="Ex: 123 rue de la Paix" required>
                        </div>
                        <div class="mb-3">
                            <label for="complement" class="form-label">Complément d'adresse (optionnel)</label>
                            <input type="text" class="form-control" id="complement" name="complement" placeholder="Ex: Appartement 4B, Étage 2, etc.">
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label for="code_postal" class="form-label">Code postal</label>
                                <input type="text" class="form-control" id="code_postal" name="code_postal" required>
                            </div>
                            <div class="col-md-8">
                                <label for="ville" class="form-label">Ville</label>
                                <input type="text" class="form-control" id="ville" name="ville" required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="pays" class="form-label">Pays</label>
                            <select class="form-select" id="pays" name="pays" required>
                                <option value="France" selected>France</option>
                                <option value="Belgique">Belgique</option>
                                <option value="Suisse">Suisse</option>
                                <option value="Luxembourg">Luxembourg</option>
                                <option value="Monaco">Monaco</option>
                                <option value="Allemagne">Allemagne</option>
                                <option value="Espagne">Espagne</option>
                                <option value="Italie">Italie</option>
                                <option value="Royaume-Uni">Royaume-Uni</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="telephone" class="form-label">Téléphone</label>
                            <input type="tel" class="form-control" id="telephone" name="telephone" value="{{ client.telephone }}" required>
                            <div class="form-text">Ce numéro sera utilisé en cas de problème de livraison.</div>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="is_default" name="is_default" value="1">
                            <label class="form-check-label" for="is_default">
                                Définir comme adresse par défaut
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" name="ajouter_adresse" class="btn btn-purple">Ajouter</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modals modification adresse pour chaque adresse -->
    {% if adresses|length > 0 %}
        {% for adresse in adresses %}
            <div class="modal fade" id="editAddressModal{{ adresse.id }}" tabindex="-1" aria-labelledby="editAddressModalLabel{{ adresse.id }}" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form action="index.php?page=adresses" method="post">
                            <input type="hidden" name="id_adresse" value="{{ adresse.id }}">
                            <div class="modal-header">
                                <h5 class="modal-title" id="editAddressModalLabel{{ adresse.id }}">Modifier l'adresse</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label for="nom_adresse{{ adresse.id }}" class="form-label">Nom de l'adresse</label>
                                    <input type="text" class="form-control" id="nom_adresse{{ adresse.id }}" name="nom_adresse" value="{{ adresse.nom }}" required>
                                </div>
                                <div class="mb-3">
                                    <label for="type_adresse{{ adresse.id }}" class="form-label">Type d'adresse</label>
                                    <select class="form-select" id="type_adresse{{ adresse.id }}" name="type_adresse" required>
                                        <option value="livraison" {% if adresse.type == 'livraison' %}selected{% endif %}>Adresse de livraison</option>
                                        <option value="facturation" {% if adresse.type == 'facturation' %}selected{% endif %}>Adresse de facturation</option>
                                        <option value="les_deux" {% if adresse.type == 'les_deux' %}selected{% endif %}>Livraison et facturation</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label for="nom_complet{{ adresse.id }}" class="form-label">Nom complet</label>
                                    <input type="text" class="form-control" id="nom_complet{{ adresse.id }}" name="nom_complet" value="{{ adresse.nom_complet|default(client.prenom ~ ' ' ~ client.nom) }}" required>
                                </div>
                                <div class="mb-3">
                                    <label for="rue{{ adresse.id }}" class="form-label">Rue et numéro</label>
                                    <input type="text" class="form-control" id="rue{{ adresse.id }}" name="rue" value="{{ adresse.rue }}" required>
                                </div>
                                <div class="mb-3">
                                    <label for="complement{{ adresse.id }}" class="form-label">Complément d'adresse (optionnel)</label>
                                    <input type="text" class="form-control" id="complement{{ adresse.id }}" name="complement" value="{{ adresse.complement }}">
                                </div>
                                <div class="row mb-3">
                                    <div class="col-md-4">
                                        <label for="code_postal{{ adresse.id }}" class="form-label">Code postal</label>
                                        <input type="text" class="form-control" id="code_postal{{ adresse.id }}" name="code_postal" value="{{ adresse.code_postal }}" required>
                                    </div>
                                    <div class="col-md-8">
                                        <label for="ville{{ adresse.id }}" class="form-label">Ville</label>
                                        <input type="text" class="form-control" id="ville{{ adresse.id }}" name="ville" value="{{ adresse.ville }}" required>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label for="pays{{ adresse.id }}" class="form-label">Pays</label>
                                    <select class="form-select" id="pays{{ adresse.id }}" name="pays" required>
                                        <option value="France" {% if adresse.pays == 'France' or adresse.pays is not defined %}selected{% endif %}>France</option>
                                        <option value="Belgique" {% if adresse.pays == 'Belgique' %}selected{% endif %}>Belgique</option>
                                        <option value="Suisse" {% if adresse.pays == 'Suisse' %}selected{% endif %}>Suisse</option>
                                        <option value="Luxembourg" {% if adresse.pays == 'Luxembourg' %}selected{% endif %}>Luxembourg</option>
                                        <option value="Monaco" {% if adresse.pays == 'Monaco' %}selected{% endif %}>Monaco</option>
                                        <option value="Allemagne" {% if adresse.pays == 'Allemagne' %}selected{% endif %}>Allemagne</option>
                                        <option value="Espagne" {% if adresse.pays == 'Espagne' %}selected{% endif %}>Espagne</option>
                                        <option value="Italie" {% if adresse.pays == 'Italie' %}selected{% endif %}>Italie</option>
                                        <option value="Royaume-Uni" {% if adresse.pays == 'Royaume-Uni' %}selected{% endif %}>Royaume-Uni</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label for="telephone{{ adresse.id }}" class="form-label">Téléphone</label>
                                    <input type="tel" class="form-control" id="telephone{{ adresse.id }}" name="telephone" value="{{ adresse.telephone }}" required>
                                </div>
                                {% if not adresse.is_default %}
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="is_default{{ adresse.id }}" name="is_default" value="1">
                                        <label class="form-check-label" for="is_default{{ adresse.id }}">
                                            Définir comme adresse par défaut
                                        </label>
                                    </div>
                                {% endif %}
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                                <button type="submit" name="modifier_adresse" class="btn btn-purple">Enregistrer</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Modal de suppression -->
            <div class="modal fade" id="deleteAddressModal{{ adresse.id }}" tabindex="-1" aria-labelledby="deleteAddressModalLabel{{ adresse.id }}" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form action="index.php?page=adresses" method="post">
                            <input type="hidden" name="id_adresse" value="{{ adresse.id }}">
                            <div class="modal-header">
                                <h5 class="modal-title" id="deleteAddressModalLabel{{ adresse.id }}">Confirmer la suppression</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <p>Êtes-vous sûr de vouloir supprimer l'adresse <strong>{{ adresse.nom }}</strong> ?</p>
                                {% if adresse.is_default %}
                                    <div class="alert alert-warning">
                                        <i class="fas fa-exclamation-triangle me-2"></i> Attention : il s'agit de votre adresse par défaut. 
                                        Si vous la supprimez, vous devrez définir une nouvelle adresse par défaut.
                                    </div>
                                {% endif %}
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                                <button type="submit" name="supprimer_adresse" class="btn btn-danger">Supprimer</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        {% endfor %}
    {% endif %}
{% endblock %}

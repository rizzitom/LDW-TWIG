{% extends "client/base-client.twig" %}

{% block client_title %}Mes messages{% endblock %}

{% block client_actions %}
<button type="button" class="btn btn-purple" data-bs-toggle="modal" data-bs-target="#newMessageModal">
    <i class="fas fa-paper-plane me-2"></i> Nouveau message
</button>
{% endblock %}

{% block client_content %}
    <div class="row">
        <!-- Colonne liste des conversations -->
        <div class="col-lg-4 mb-4 mb-lg-0">
            <div class="client-card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <div>
                        <i class="fas fa-comments me-2"></i> Conversations
                    </div>
                    <div class="input-group input-group-sm" style="width: 150px;">
                        <input type="text" class="form-control" id="searchConversations" placeholder="Rechercher...">
                        <button class="btn btn-outline-secondary" type="button">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush conversation-list">
                        {% if conversations|length > 0 %}
                            {% for conversation in conversations %}
                                <a href="index.php?page=messages&id={{ conversation.id }}" class="list-group-item list-group-item-action {% if conversation.id == conversation_active.id %}active{% endif %} {% if conversation.unread %}unread{% endif %}">
                                    <div class="d-flex w-100 justify-content-between align-items-center">
                                        <h6 class="mb-1 text-truncate">{{ conversation.sujet }}</h6>
                                        <small class="text-muted">{{ conversation.date_dernier_message|date("d/m/Y") }}</small>
                                    </div>
                                    <div class="d-flex w-100 justify-content-between align-items-center">
                                        <small class="mb-1 text-truncate">
                                            {% if conversation.dernier_message_par_client %}
                                                <i class="fas fa-reply text-primary me-1"></i>
                                            {% else %}
                                                <i class="fas fa-comment text-success me-1"></i>
                                            {% endif %}
                                            {{ conversation.extrait|default('...') }}
                                        </small>
                                        {% if conversation.unread %}
                                            <span class="badge bg-primary rounded-pill">{{ conversation.unread }}</span>
                                        {% endif %}
                                    </div>
                                    <div class="d-flex w-100 justify-content-between text-muted small mt-1">
                                        <span>
                                            <i class="fas fa-tag me-1"></i>
                                            {% if conversation.type == 'commande' %}
                                                Commande
                                            {% elseif conversation.type == 'support' %}
                                                Support technique
                                            {% elseif conversation.type == 'reclamation' %}
                                                Réclamation
                                            {% else %}
                                                Général
                                            {% endif %}
                                        </span>
                                        <span>
                                            {% if conversation.statut == 'ouvert' %}
                                                <i class="fas fa-circle text-success me-1" style="font-size: 0.7em;"></i> En cours
                                            {% elseif conversation.statut == 'en_attente' %}
                                                <i class="fas fa-circle text-warning me-1" style="font-size: 0.7em;"></i> En attente
                                            {% elseif conversation.statut == 'resolu' %}
                                                <i class="fas fa-check-circle text-muted me-1"></i> Résolu
                                            {% endif %}
                                        </span>
                                    </div>
                                </a>
                            {% endfor %}
                        {% else %}
                            <div class="text-center py-5">
                                <i class="fas fa-comments text-muted fa-3x mb-3"></i>
                                <p>Aucune conversation en cours</p>
                                <button type="button" class="btn btn-sm btn-purple" data-bs-toggle="modal" data-bs-target="#newMessageModal">
                                    <i class="fas fa-plus-circle me-1"></i> Démarrer une conversation
                                </button>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <!-- Colonne détail de conversation -->
        <div class="col-lg-8">
            {% if conversation_active %}
                <div class="client-card h-100 d-flex flex-column">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="mb-0"><i class="fas fa-comment-dots me-2"></i> {{ conversation_active.sujet }}</h5>
                            <div class="text-muted small">
                                <span class="me-3">Créé le {{ conversation_active.date_creation|date("d/m/Y") }}</span>
                                <span class="badge {% if conversation_active.statut == 'ouvert' %}bg-success{% elseif conversation_active.statut == 'en_attente' %}bg-warning{% elseif conversation_active.statut == 'resolu' %}bg-secondary{% endif %}">
                                    {% if conversation_active.statut == 'ouvert' %}
                                        En cours
                                    {% elseif conversation_active.statut == 'en_attente' %}
                                        En attente
                                    {% elseif conversation_active.statut == 'resolu' %}
                                        Résolu
                                    {% endif %}
                                </span>
                            </div>
                        </div>
                        <div>
                            {% if conversation_active.statut != 'resolu' %}
                                <form action="index.php?page=messages" method="post" class="d-inline">
                                    <input type="hidden" name="id_conversation" value="{{ conversation_active.id }}">
                                    <button type="submit" name="marquer_resolu" class="btn btn-sm btn-outline-success me-1">
                                        <i class="fas fa-check me-1"></i> Marquer comme résolu
                                    </button>
                                </form>
                            {% else %}
                                <form action="index.php?page=messages" method="post" class="d-inline">
                                    <input type="hidden" name="id_conversation" value="{{ conversation_active.id }}">
                                    <button type="submit" name="reouvrir" class="btn btn-sm btn-outline-primary me-1">
                                        <i class="fas fa-redo me-1"></i> Rouvrir
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Zone des messages -->
                    <div class="card-body p-3 flex-grow-1 overflow-auto" id="messageContainer" style="max-height: 500px;">
                        <div class="d-flex flex-column">
                            {% if conversation_active.messages|length > 0 %}
                                {% for message in conversation_active.messages %}
                                    <div class="message-bubble {% if message.est_client %}message-client{% else %}message-support{% endif %} mb-3">
                                        <div class="message-header d-flex justify-content-between">
                                            <span class="fw-bold">
                                                {% if message.est_client %}
                                                    {{ client.prenom }} {{ client.nom }}
                                                {% else %}
                                                    {{ message.nom_support|default('Support LDW') }}
                                                {% endif %}
                                            </span>
                                            <span class="text-muted small">{{ message.date_creation|date("d/m/Y à H:i") }}</span>
                                        </div>
                                        <div class="message-content">
                                            {{ message.contenu|raw|nl2br }}
                                        </div>
                                        {% if message.pieces_jointes|length > 0 %}
                                            <div class="message-attachments mt-2">
                                                {% for piece in message.pieces_jointes %}
                                                    <div class="message-attachment">
                                                        <a href="{{ piece.url }}" target="_blank" class="text-decoration-none">
                                                            <i class="fas fa-paperclip me-1"></i> {{ piece.nom }}
                                                        </a>
                                                        <span class="text-muted ms-2 small">({{ piece.taille }})</span>
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            {% else %}
                                <div class="text-center py-4">
                                    <i class="fas fa-comments text-muted fa-3x mb-3"></i>
                                    <p>Aucun message dans cette conversation</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Zone de réponse -->
                    {% if conversation_active.statut != 'resolu' %}
                        <div class="card-footer p-3 bg-transparent">
                            <form action="index.php?page=messages" method="post" enctype="multipart/form-data">
                                <input type="hidden" name="id_conversation" value="{{ conversation_active.id }}">
                                <div class="mb-3">
                                    <textarea class="form-control" name="message" rows="3" placeholder="Tapez votre message..." required></textarea>
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <label for="pieceJointe" class="btn btn-sm btn-outline-secondary">
                                            <i class="fas fa-paperclip me-1"></i> Joindre un fichier
                                        </label>
                                        <input type="file" id="pieceJointe" name="piece_jointe" class="visually-hidden">
                                        <span id="fileNameDisplay" class="ms-2 small"></span>
                                    </div>
                                    <button type="submit" name="envoyer_message" class="btn btn-purple">
                                        <i class="fas fa-paper-plane me-1"></i> Envoyer
                                    </button>
                                </div>
                            </form>
                        </div>
                    {% else %}
                        <div class="card-footer p-3 bg-transparent text-center">
                            <p class="text-muted mb-2">Cette conversation est marquée comme résolue</p>
                            <form action="index.php?page=messages" method="post" class="d-inline">
                                <input type="hidden" name="id_conversation" value="{{ conversation_active.id }}">
                                <button type="submit" name="reouvrir" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-redo me-1"></i> Rouvrir la conversation
                                </button>
                            </form>
                        </div>
                    {% endif %}
                </div>
            {% else %}
                <div class="client-card h-100">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center text-center py-5">
                        <img src="{{ get_asset_url('/public/images/undraw_mailbox.svg') }}" alt="Support client" class="img-fluid mb-4" style="max-height: 200px;">
                        <h4 class="mb-3">Besoin d'aide ?</h4>
                        <p class="text-muted mb-4">Sélectionnez une conversation existante ou démarrez-en une nouvelle pour contacter notre équipe de support.</p>
                        <button type="button" class="btn btn-purple" data-bs-toggle="modal" data-bs-target="#newMessageModal">
                            <i class="fas fa-plus-circle me-2"></i> Nouvelle conversation
                        </button>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

    <!-- FAQ Support -->
    <div class="client-card mt-4">
        <div class="card-header">
            <i class="fas fa-question-circle me-2"></i> Questions fréquentes sur le support
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="mb-3">
                        <h6 class="fw-bold"><i class="fas fa-clock text-primary me-2"></i> Quels sont les délais de réponse ?</h6>
                        <p>Notre équipe s'engage à vous répondre dans un délai de 24h ouvrées. Pour les demandes urgentes, 
                        nous vous conseillons de contacter directement notre service client par téléphone au 01 23 45 67 89.</p>
                    </div>
                    <div>
                        <h6 class="fw-bold"><i class="fas fa-paperclip text-primary me-2"></i> Quels fichiers puis-je joindre ?</h6>
                        <p>Vous pouvez joindre des images (JPG, PNG, GIF), des documents (PDF, DOCX, XLSX) et des fichiers 
                        compressés (ZIP, RAR). La taille maximum par fichier est de 5 Mo.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <h6 class="fw-bold"><i class="fas fa-tag text-primary me-2"></i> Comment catégoriser mes demandes ?</h6>
                        <p>Choisissez le type de demande approprié lors de la création d'une conversation pour une prise en 
                        charge optimale. Pour les questions liées à une commande, sélectionnez "Commande" et précisez 
                        la référence dans le sujet.</p>
                    </div>
                    <div>
                        <h6 class="fw-bold"><i class="fas fa-history text-primary me-2"></i> Pendant combien de temps mes messages sont-ils conservés ?</h6>
                        <p>Vos conversations sont conservées pendant 2 ans après leur clôture. Vous pouvez les 
                        consulter à tout moment dans votre espace client.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block client_modals %}
    <!-- Modal nouveau message -->
    <div class="modal fade" id="newMessageModal" tabindex="-1" aria-labelledby="newMessageModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form action="index.php?page=messages" method="post" enctype="multipart/form-data">
                    <div class="modal-header">
                        <h5 class="modal-title" id="newMessageModalLabel">Nouveau message</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="sujet" class="form-label">Sujet</label>
                            <input type="text" class="form-control" id="sujet" name="sujet" placeholder="Résumez votre demande en quelques mots" required value="{{ sujet_prefilled }}">
                        </div>
                        <div class="mb-3">
                            <label for="type" class="form-label">Type de demande</label>
                            <select class="form-select" id="type" name="type" required>
                                <option value="general" {% if type_prefilled == 'general' %}selected{% endif %}>Question générale</option>
                                <option value="commande" {% if type_prefilled == 'commande' %}selected{% endif %}>Question sur une commande</option>
                                <option value="reclamation" {% if type_prefilled == 'reclamation' %}selected{% endif %}>Réclamation</option>
                                <option value="support" {% if type_prefilled == 'support' %}selected{% endif %}>Support technique</option>
                                <option value="autre" {% if type_prefilled == 'autre' %}selected{% endif %}>Autre</option>
                            </select>
                        </div>
                        
                        <div id="commandeSection" class="mb-3 {% if type_prefilled != 'commande' %}d-none{% endif %}">
                            <label for="reference_commande" class="form-label">Référence de commande (optionnel)</label>
                            <select class="form-select" id="reference_commande" name="reference_commande">
                                <option value="">Sélectionnez une commande</option>
                                {% for commande in dernieres_commandes %}
                                    <option value="{{ commande.reference }}" {% if commande_prefilled == commande.reference %}selected{% endif %}>
                                        {{ commande.reference }} - {{ commande.date_commande|date("d/m/Y") }} ({{ commande.montant_total|number_format(2, ',', ' ') }} €)
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        
                        <div class="mb-3">
                            <label for="message" class="form-label">Message</label>
                            <textarea class="form-control" id="message" name="message" rows="5" placeholder="Décrivez votre demande en détail..." required></textarea>
                        </div>
                        
                        <div class="mb-3">
                            <label for="piece_jointe" class="form-label">Pièce jointe (optionnel)</label>
                            <input type="file" class="form-control" id="piece_jointe" name="piece_jointe">
                            <div class="form-text">
                                Formats acceptés : JPG, PNG, PDF, DOCX - Max 5 Mo
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" name="nouvelle_conversation" class="btn btn-purple">Envoyer</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}

{% block client_scripts %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Scroll to bottom of message container
        const messageContainer = document.getElementById('messageContainer');
        if (messageContainer) {
            messageContainer.scrollTop = messageContainer.scrollHeight;
        }
        
        // File attachment display
        const fileInput = document.getElementById('pieceJointe');
        const fileNameDisplay = document.getElementById('fileNameDisplay');
        
        if (fileInput && fileNameDisplay) {
            fileInput.addEventListener('change', function() {
                if (this.files && this.files.length > 0) {
                    fileNameDisplay.textContent = this.files[0].name;
                } else {
                    fileNameDisplay.textContent = '';
                }
            });
        }
        
        // Toggle commande reference field visibility
        const typeSelect = document.getElementById('type');
        const commandeSection = document.getElementById('commandeSection');
        
        if (typeSelect && commandeSection) {
            typeSelect.addEventListener('change', function() {
                if (this.value === 'commande') {
                    commandeSection.classList.remove('d-none');
                } else {
                    commandeSection.classList.add('d-none');
                }
            });
        }
        
        // Search conversations
        const searchInput = document.getElementById('searchConversations');
        const conversationItems = document.querySelectorAll('.conversation-list .list-group-item');
        
        if (searchInput && conversationItems.length > 0) {
            searchInput.addEventListener('input', function() {
                const searchTerm = this.value.toLowerCase();
                
                conversationItems.forEach(item => {
                    const subject = item.querySelector('h6').textContent.toLowerCase();
                    const content = item.querySelector('small:nth-child(1)').textContent.toLowerCase();
                    
                    if (subject.includes(searchTerm) || content.includes(searchTerm)) {
                        item.style.display = '';
                    } else {
                        item.style.display = 'none';
                    }
                });
            });
        }
    });
</script>
{% endblock %}

{% block head %}
{{ parent() }}
<style>
    .conversation-list .list-group-item {
        transition: background-color 0.2s ease;
        border-left: 3px solid transparent;
    }
    
    .conversation-list .list-group-item:hover {
        background-color: rgba(var(--violet-principal-rgb), 0.05);
    }
    
    .conversation-list .list-group-item.active {
        background-color: rgba(var(--violet-principal-rgb), 0.1);
        color: var(--texte-couleur);
        border-left-color: var(--violet-principal);
    }
    
    .conversation-list .list-group-item.unread {
        border-left-color: var(--violet-accent);
        font-weight: 500;
    }
    
    .message-bubble {
        padding: 1rem;
        border-radius: 0.75rem;
        position: relative;
        max-width: 85%;
    }
    
    .message-client {
        align-self: flex-end;
        background-color: rgba(var(--violet-principal-rgb), 0.1);
        margin-left: auto;
        border-bottom-right-radius: 0.25rem;
    }
    
    .message-support {
        align-self: flex-start;
        background-color: var(--fond-tertiaire);
        margin-right: auto;
        border-bottom-left-radius: 0.25rem;
    }
    
    .message-header {
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
    }
    
    .message-content {
        line-height: 1.5;
    }
    
    .message-attachments {
        padding-top: 0.5rem;
        border-top: 1px solid rgba(var(--bordure-couleur), 0.5);
    }
    
    .message-attachment {
        font-size: 0.9rem;
        margin-bottom: 0.25rem;
    }
    
    /* Styles pour les messages non lus */
    .unread-indicator {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: var(--violet-principal);
        display: inline-block;
        margin-right: 5px;
    }
</style>
{% endblock %}

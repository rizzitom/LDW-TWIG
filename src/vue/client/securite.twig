    .password-strength-meter {
        margin-top: 10px;
    }
    
    /* Style pour l'entrée de code de vérification */
    .verification-code-container {
        display: flex;
        justify-content: center;
    }
    
    .verification-code-input {
        letter-spacing: 0.5rem;
        text-align: center;
        font-family: monospace;
        font-size: 1.2rem;
        width: 180px;
    }
    
    /* Style pour le QR code */
    .qr-code {
        max-width: 200px;
        border: 1px solid var(--bordure-couleur);
        padding: 10px;
        background-color: white;
    }
    
    /* Style pour la section des options de sécurité */
    .security-option {
        border-left: 3px solid var(--violet-principal);
        padding-left: 15px;
        margin-bottom: 20px;
    }
    
    .security-option h6 {
        font-weight: 600;
        color: var(--texte-couleur);
    }
</style>
{% endblock %}

        <script>
            function copyToClipboard(text) {
                // Créer un élément temporaire
                const el = document.createElement('textarea');
                el.value = text;
                document.body.appendChild(el);
                el.select();
                document.execCommand('copy');
                document.body.removeChild(el);
                
                // Afficher une notification
                const notification = document.createElement('div');
                notification.className = 'copy-notification animate__animated animate__fadeIn';
                notification.innerHTML = '<i class="fas fa-check"></i> Référence copiée !';
                document.body.appendChild(notification);
                
                // Supprimer la notification après 2 secondes
                setTimeout(() => {
                    notification.className = 'copy-notification animate__animated animate__fadeOut';
                    setTimeout(() => {
                        document.body.removeChild(notification);
                    }, 1000);
                }, 2000);
            }
        </script>
        

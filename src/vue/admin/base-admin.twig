{% extends "base.twig" %}

{# Override base.twig head to add admin-specific styles #}
{% block head %}
    {{ parent() }} {# Include base.twig head content (fonts, bootstrap css, etc.) #}
    <style>
        /* ============================================== */
        /* ADMIN BASE STYLES                     */
        /* ============================================== */

        /* --- Layout --- */
        .admin-wrapper { /* New wrapper for main content */
             padding-left: 280px; /* Match sidebar width */
             transition: padding-left 0.3s ease;
         }
        .admin-sidebar {
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
            width: 280px; /* Sidebar width */
            background-color: var(--fond-secondaire);
            border-right: 1px solid var(--bordure-couleur);
            padding: 1.5rem;
            overflow-y: auto; /* Scroll if content overflows */
            z-index: 1031; /* Above header scroll but below modals */
             transition: transform 0.3s ease;
             box-shadow: 4px 0 15px var(--ombre-couleur);
        }
         /* Toggle Sidebar (Example structure - needs JS) */
         body.sidebar-toggled .admin-sidebar {
             transform: translateX(-100%);
         }
          body.sidebar-toggled .admin-wrapper {
              padding-left: 0;
          }
           body.sidebar-toggled .admin-header .sidebar-toggle-btn i::before {
               content: "\f0c9"; /* Bars icon */
           }

        .admin-sidebar-header {
            display: flex;
            align-items: center;
            margin-bottom: 2rem; /* More space */
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--bordure-couleur);
        }
         .admin-sidebar-header img { height: 35px; }
         .admin-sidebar-header h4 {
            margin-bottom: 0;
            margin-left: 0.75rem;
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--texte-couleur);
         }

        .admin-sidebar .nav-link {
            color: var(--texte-secondaire);
            padding: 0.8rem 1rem; /* Increased padding */
            border-radius: 0.5rem; /* Rounded corners */
            margin-bottom: 0.25rem; /* Reduced margin */
            transition: background-color 0.2s ease, color 0.2s ease, padding-left 0.2s ease;
            display: flex;
            align-items: center;
            font-size: 0.95rem;
            font-weight: 500;
        }
        .admin-sidebar .nav-link:hover {
            background-color: rgba(var(--violet-principal-rgb), 0.1);
            color: var(--texte-couleur);
            padding-left: 1.25rem; /* Indent on hover */
        }
        .admin-sidebar .nav-link.active {
            background-color: var(--violet-principal);
            color: var(--white); /* White text on primary bg */
            font-weight: 600;
            box-shadow: 0 3px 8px rgba(var(--violet-principal-rgb), 0.3);
        }
        .admin-sidebar .nav-link.active:hover {
             padding-left: 1rem; /* Reset indent on active hover */
         }
        .admin-sidebar .nav-link i {
            width: 22px; /* Increased width */
            text-align: center;
            margin-right: 10px; /* Increased margin */
            font-size: 1.05em; /* Slightly larger icons */
            opacity: 0.8;
             transition: opacity 0.2s ease;
        }
         .admin-sidebar .nav-link:hover i,
         .admin-sidebar .nav-link.active i {
             opacity: 1;
         }


        /* --- Main Content Area --- */
        .admin-container {
            /* background-color: var(--fond-primaire); */ /* Removed, uses body bg */
            padding: 1.5rem; /* Reduced padding */
            margin-bottom: 2rem;
            border-radius: 0; /* No radius needed if it's the main area */
             /* Min height to push footer down */
             min-height: calc(100vh - 80px); /* Adjust 80px based on header height */
        }
        .admin-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid var(--bordure-couleur);
        }
         /* Bouton pour afficher/cacher sidebar (Exemple) */
         .sidebar-toggle-btn {
            background: none;
            border: none;
            color: var(--texte-secondaire);
            font-size: 1.5rem;
            padding: 0 0.5rem;
             margin-right: 1rem;
         }
         .sidebar-toggle-btn:hover { color: var(--violet-accent); }


        .admin-title {
            margin-bottom: 0;
            font-size: 1.8rem; /* Increased size */
            font-weight: 700;
            color: var(--texte-couleur);
        }

        /* ============================================== */
        /* STYLES COMPOSANTS ADMIN (Consolidés)   */
        /* ============================================== */

        /* --- Cartes Admin --- */
        .card-admin {
            background-color: var(--fond-secondaire);
            border: 1px solid var(--bordure-couleur);
            border-radius: 0.75rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 3px 8px var(--ombre-couleur);
             height: 100%; /* For equal height cards in rows */
        }
        .card-admin .card-header {
            background-color: var(--fond-tertiaire); /* Header plus subtil */
            border-bottom: 1px solid var(--bordure-couleur);
            border-radius: 0.75rem 0.75rem 0 0;
            color: var(--texte-couleur);
            font-weight: 600;
            padding: 1rem 1.5rem;
             font-size: 1.05rem;
        }
        .card-admin .card-header i {
            margin-right: 0.5rem;
            opacity: 0.8;
        }
        .card-admin .card-body {
            padding: 1.5rem;
        }
        .card-admin .card-body.p-0 .table-responsive {
            border-radius: 0 0 0.75rem 0.75rem;
            overflow: hidden;
        }
         /* Adapte bouton dans header de carte */
         .card-admin .card-header .btn {
             font-size: 0.8rem;
             padding: 0.25rem 0.75rem;
         }

        /* --- Tableaux Admin --- */
        .admin-table-wrapper { /* New class for rounded corners on responsive table */
            background-color: var(--fond-secondaire);
            border: 1px solid var(--bordure-couleur);
            border-radius: 0.75rem;
            overflow: hidden; /* Crucial for radius */
            box-shadow: 0 3px 8px var(--ombre-couleur);
        }
        .table {
            --bs-table-bg: var(--fond-secondaire);
            --bs-table-border-color: var(--bordure-couleur);
            --bs-table-color: var(--texte-couleur);
            --bs-table-striped-bg: var(--fond-tertiaire);
            --bs-table-hover-bg: var(--fond-tertiaire);
            --bs-table-hover-color: var(--texte-couleur);
            margin-bottom: 0;
        }
        .table thead th {
            font-weight: 600;
            color: var(--texte-secondaire);
            border-bottom-width: 1px;
            font-size: 0.85rem; /* Smaller header */
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap; /* Prevent wrapping */
            padding: 0.75rem 1rem; /* Adjusted padding */
             background-color: var(--fond-tertiaire); /* Header background */
             border-top: 0; /* Remove top border on header */
        }
        .table tbody td {
            padding: 0.75rem 1rem; /* Adjusted padding */
            vertical-align: middle;
            font-size: 0.9rem; /* Slightly smaller body */
        }
        .table-hover tbody tr.hoverable-row:hover {
            background-color: var(--fond-tertiaire);
            cursor: pointer;
        }
        .table .text-danger { color: var(--danger-color) !important; }
        .table .text-warning { color: var(--warning-color) !important; }
        .table .text-muted { color: var(--texte-mute) !important; }

        /* --- Cartes Statistiques --- */
        .stat-card {
            background: var(--fond-secondaire); /* Use simple background */
            border-radius: 0.75rem;
            padding: 1.5rem;
            position: relative;
            overflow: hidden;
            border: 1px solid var(--bordure-couleur);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            box-shadow: 0 4px 10px var(--ombre-couleur);
            color: var(--texte-couleur);
            height: 100%;
            display: flex;
            flex-direction: column;
        }
        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px var(--ombre-couleur);
        }
        .stat-icon {
            position: absolute;
            bottom: 10px; /* Adjusted position */
            right: 15px;
            font-size: 3.5rem; /* Adjusted size */
            opacity: 0.1; /* Reduced opacity */
            color: var(--violet-principal);
             transform: rotate(-10deg);
        }
        .stat-value {
            font-size: 2.2rem; /* Adjusted size */
            font-weight: 700;
            margin-bottom: 0.25rem;
            color: var(--violet-accent);
            line-height: 1.2;
        }
        .stat-label {
            font-size: 0.9rem;
            color: var(--texte-secondaire);
            margin-bottom: 1rem;
            flex-grow: 1;
        }
        .progress-bar-admin {
            height: 6px;
            background-color: var(--fond-tertiaire);
            border-radius: 3px;
            overflow: hidden;
            margin-top: auto;
        }
        .progress-value {
            height: 100%;
            border-radius: 3px;
            background: linear-gradient(to right, var(--violet-principal), var(--violet-accent)); /* Gradient progress */
            transition: width 0.5s ease-in-out;
        }

         /* --- Badges Statut --- */
        .status-badge {
            display: inline-block;
            padding: 0.3em 0.7em; /* Smaller padding */
            font-size: 0.75rem; /* Smaller text */
            font-weight: 600; /* Bolder */
            border-radius: 50px;
            text-align: center;
            min-width: 70px; /* Reduced min-width */
            border: 1px solid transparent; /* Base border */
        }
        .status-pending {
            background-color: rgba(var(--bs-warning-rgb), 0.1);
            color: var(--warning-color);
            border-color: rgba(var(--bs-warning-rgb), 0.3);
        }
        .status-processing {
            background-color: rgba(var(--bs-primary-rgb), 0.1);
            color: var(--violet-principal);
            border-color: rgba(var(--bs-primary-rgb), 0.3);
        }
        .status-shipped {
             background-color: rgba(var(--violet-principal-rgb), 0.15);
             color: var(--violet-accent);
             border-color: rgba(var(--violet-principal-rgb), 0.4);
        }
        .status-delivered {
            background-color: rgba(var(--bs-success-rgb), 0.1);
            color: var(--success-color);
             border-color: rgba(var(--bs-success-rgb), 0.3);
        }
        .status-cancelled {
            background-color: rgba(var(--bs-danger-rgb), 0.1);
            color: var(--danger-color);
             border-color: rgba(var(--bs-danger-rgb), 0.3);
        }

        /* --- Conteneurs Graphiques --- */
        .chart-container {
            background-color: var(--fond-secondaire);
            border-radius: 0.75rem;
            padding: 1.5rem;
            border: 1px solid var(--bordure-couleur);
            box-shadow: 0 4px 10px var(--ombre-couleur);
            height: 400px;
            position: relative;
        }
        .chart-container h5 {
            font-weight: 600;
            color: var(--texte-couleur);
            font-size: 1.1rem;
             margin-bottom: 1rem; /* Espace sous titre */
        }
        .chart-container canvas { max-height: 330px; }

         /* --- Notifications (Exemple si besoin) --- */
         /* Style à adapter selon l'implémentation */

         /* --- Filtres Section Admin --- */
         .filter-section {
             background-color: var(--fond-secondaire);
             border-radius: 0.75rem;
             padding: 1.5rem;
             margin-bottom: 1.5rem;
             border: 1px solid var(--bordure-couleur);
             box-shadow: 0 3px 8px var(--ombre-couleur);
         }

         /* --- Pagination Admin --- */
         .pagination-admin { justify-content: center; margin-top: 1.5rem; }
         .pagination-admin .page-link {
             color: var(--violet-accent);
             background-color: var(--fond-tertiaire);
             border-color: var(--bordure-couleur);
             margin: 0 0.2rem;
             border-radius: 0.3rem;
             transition: background-color 0.2s ease, color 0.2s ease;
         }
         .pagination-admin .page-link:hover {
             background-color: var(--violet-principal);
             color: var(--white);
             border-color: var(--violet-principal);
         }
         .pagination-admin .page-item.active .page-link {
             background-color: var(--violet-principal);
             border-color: var(--violet-principal);
             color: var(--white);
         }
         .pagination-admin .page-item.disabled .page-link {
             color: var(--texte-mute);
             background-color: var(--fond-secondaire);
             border-color: var(--bordure-couleur);
         }

         /* --- Modals Admin --- */
         .modal-admin .modal-content {
             background-color: var(--fond-secondaire);
             color: var(--texte-couleur);
             border: 1px solid var(--bordure-couleur);
             border-radius: 0.75rem;
         }
         .modal-admin .modal-header {
             border-bottom-color: var(--bordure-couleur);
              background-color: var(--fond-tertiaire);
             border-top-left-radius: 0.75rem;
             border-top-right-radius: 0.75rem;
         }
          .modal-admin .modal-header .btn-close {
               filter: invert(1) grayscale(100%) brightness(200%); /* Adapte bouton close pour fond sombre */
           }
           body.light-theme .modal-admin .modal-header .btn-close { filter: none; }

         .modal-admin .modal-footer {
             border-top-color: var(--bordure-couleur);
              background-color: var(--fond-tertiaire);
             border-bottom-left-radius: 0.75rem;
             border-bottom-right-radius: 0.75rem;
         }

    </style>
{% endblock %}

{# Le body ici REMPLACE celui de base.twig #}
{% block body %}
<div class="d-flex admin-layout-wrapper"> {# Wrapper pour gérer sidebar/content #}
    <aside class="admin-sidebar">
        <div class="admin-sidebar-header">
            {# Logo admin, utilise l'ID pour potentielle mise à jour thème si différent du logo public #}

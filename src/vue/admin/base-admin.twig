             <hr style="border-color: var(--bordure-couleur); margin: 1rem 0;">
             <a class="nav-link" href="index.php" target="_blank"> {# Ouvre dans un nouvel onglet #}
                <i class="fas fa-external-link-alt"></i> Voir le site public
             </a>
             <a class="nav-link" href="index.php?page=deconnexion">
                  <i class="fas fa-sign-out-alt"></i> Déconnexion
              </a>
        </nav>
    </aside>

    <div class="admin-wrapper">
         {# Header admin (optionnel, peut contenir titre page + actions) #}
         <header class="admin-header">
             {# Bouton pour cacher/afficher sidebar (mobile) - JS requis #}
              <button class="sidebar-toggle-btn d-lg-none" type="button" title="Menu" aria-label="Toggle sidebar">
                   <i class="fas fa-bars"></i>
              </button>
             <h1 class="admin-title">{% block admin_title %}Administration{% endblock %}</h1>
             <div class="admin-actions ms-auto"> {# Actions spécifiques à la page #}
                  {% block admin_actions %}{% endblock %}
                   {# Bouton Theme Toggle pour admin #}
                   <div class="theme-toggle d-inline-block ms-2" id="theme-toggle" title="Changer le thème">
                        <i class="fas"></i> {# Icône définie par JS #}
                    </div>
             </div>
         </header>

         {# Contenu principal de la page admin #}
         <main class="admin-container">
            {% block admin_content %}{% endblock %}
         </main>

         {# Footer admin (optionnel) #}
         <footer class="admin-footer text-center py-3 mt-auto">
             <small class="text-muted">&copy; {{ "now"|date("Y") }} Le Design Du Web - Administration</small>
         </footer>
    </div> {# Fin admin-wrapper #}

</div> {# Fin d-flex #}

{% block admin_modals %}{% endblock %}

{# Le bloc scripts de base.twig n'est PAS hérité car body est redéfini. #}
{# Il faut réinclure les scripts essentiels ici #}
{% block scripts %}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    {# Charger Chart.js ici si nécessaire globalement pour l'admin #}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // Reprise de la logique de thème de base.twig, adaptée pour les logos admin
        document.addEventListener('DOMContentLoaded', function() {
            const themeToggleAdmin = document.getElementById('theme-toggle'); // Utilise ID du bouton dans l'admin header
            const bodyAdmin = document.body;
            const themeIconAdmin = themeToggleAdmin ? themeToggleAdmin.querySelector('i') : null;
            const logoAdminSidebar = document.getElementById('theme-logo-admin-sidebar'); // ID du logo sidebar

             // Chemins des logos (supposons les mêmes que le site public pour l'admin)
             const logoPathLightAdmin = '{{ get_asset_url('/public/images/logov2/Logosfnoir.png') }}';
             const logoPathDarkAdmin = '{{ get_asset_url('/public/images/logov2/Logosfblanc.png') }}';

             // Fonction pour appliquer le thème (légèrement adaptée)
             function applyAdminTheme(theme, initialLoad = false) {
                bodyAdmin.classList.toggle('light-theme', theme === 'light');
                if (themeIconAdmin) themeIconAdmin.className = theme === 'light' ? 'fas fa-moon' : 'fas fa-sun';
                if (logoAdminSidebar) logoAdminSidebar.src = theme === 'light' ? logoPathLightAdmin : logoPathDarkAdmin;
                 // Appeler initCharts ici si les couleurs des graphiques doivent changer avec le thème
                 if (typeof initCharts === 'function' && !initialLoad) {
                    // Délai pour laisser les variables CSS se mettre à jour
                    setTimeout(initCharts, 50);
                 }
             }

             // Récupère et applique thème initial
             let currentAdminTheme = localStorage.getItem('theme') || 'dark'; // Synchro avec thème public
             applyAdminTheme(currentAdminTheme, true);

             // Listener pour le bouton
             if (themeToggleAdmin) {
                  themeToggleAdmin.addEventListener('click', () => {
                     currentAdminTheme = bodyAdmin.classList.contains('light-theme') ? 'dark' : 'light';
                     localStorage.setItem('theme', currentAdminTheme); // Sauvegarde globale
                     applyAdminTheme(currentAdminTheme);
                     // Déclencher un événement pour que d'autres scripts (ex: charts) réagissent si besoin
                      // document.body.dispatchEvent(new CustomEvent('themeChanged'));
                  });
             }

             // Logique pour toggle sidebar (exemple simple)
              const sidebarToggleBtn = document.querySelector('.sidebar-toggle-btn');
              if(sidebarToggleBtn) {
                  sidebarToggleBtn.addEventListener('click', () => {
                      bodyAdmin.classList.toggle('sidebar-toggled');
                  });
              }

            // Init potentiel pour Flatpickr ou Select2 (si présents sur la page chargée)
            // initPlugins(); // Appel d'une fonction qui contient ces initialisations

        }); // Fin DOMContentLoaded

         // Laisser initCharts vide ici, elle sera définie dans le bloc admin_scripts des enfants
         function initCharts() {
              // Sera surchargée par dashboard.twig ou autre page avec graphiques
              // console.log("Base admin initCharts called (should be overridden)");
         }

         // function initPlugins() {
         //    if (typeof flatpickr !== 'undefined') { ... }
         //    if (typeof $ !== 'undefined' && typeof $.fn.select2 !== 'undefined') { ... }
         // }

    </script>
    {# Bloc pour les scripts spécifiques de la page admin enfant #}
    {% block admin_scripts %}{% endblock %}
{% endblock %}
{% endblock %}

{% extends "admin/base-admin.twig" %}

{% block admin_title %}Tableau de bord{% endblock %}

{% block head %}
    {{ parent() }} {# Inclut le contenu du bloc head de base-admin.twig #}
    <style>
        /* ============================================== */
        /* STYLES DASHBOARD ADMIN                */
        /* ============================================== */

        /* --- Cartes Statistiques --- */
        .stat-card {
            background-color: var(--fond-secondaire);
            border-radius: 0.75rem;
            padding: 1.5rem;
            position: relative;
            overflow: hidden;
            border: 1px solid var(--bordure-couleur);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            box-shadow: 0 4px 10px var(--ombre-couleur);
            color: var(--texte-couleur);
            height: 100%; /* Ensure cards in a row have same height */
            display: flex;
            flex-direction: column;
        }
        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px var(--ombre-couleur);
        }
        .stat-value {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 0.25rem;
            color: var(--violet-accent); /* Valeur en accent */
            line-height: 1.2;
        }
        .stat-label {
            font-size: 0.9rem;
            color: var(--texte-secondaire);
            margin-bottom: 1rem;
            flex-grow: 1; /* Pushes progress bar down */
        }
        .stat-icon {
            position: absolute;
            top: 1.5rem;
            right: 1.5rem;
            font-size: 2.5rem;
            color: var(--violet-principal);
            opacity: 0.15;
            transform: rotate(-15deg);
        }
        .progress-bar-admin {
            height: 6px;
            background-color: var(--fond-tertiaire);
            border-radius: 3px;
            overflow: hidden;
            margin-top: auto; /* Pushes to bottom if label grows */
        }
        .progress-value {
            height: 100%;
            background-color: var(--violet-principal);
            border-radius: 3px;
            transition: width 0.5s ease-in-out;
        }

        /* --- Conteneurs Graphiques --- */
        .chart-container {
            background-color: var(--fond-secondaire);
            border-radius: 0.75rem;
            padding: 1.5rem;
            border: 1px solid var(--bordure-couleur);
            box-shadow: 0 4px 10px var(--ombre-couleur);
            height: 400px; /* Hauteur fixe pour les graphiques */
            position: relative; /* Pour Chart.js responsive */
        }
        .chart-container h5 {
            font-weight: 600;
            color: var(--texte-couleur);
            font-size: 1.1rem;
        }
        #salesChart, #categoriesChart {
            max-height: 320px; /* Limite hauteur canvas */
        }


        /* --- Cartes Admin (Tableaux) --- */
        .card-admin {
            background-color: var(--fond-secondaire);
            border-radius: 0.75rem;
            border: 1px solid var(--bordure-couleur);
            box-shadow: 0 4px 10px var(--ombre-couleur);
            overflow: hidden; /* Pour que le table-responsive n'affecte pas le radius */
        }
        .card-header {
            background-color: var(--fond-tertiaire);
            border-bottom: 1px solid var(--bordure-couleur);
            padding: 1rem 1.5rem;
        }
         .card-header h5 {
             font-weight: 600;
             color: var(--texte-couleur);
             font-size: 1.1rem;
         }
        .card-body {
             padding: 1.5rem; /* Ajouter padding si pas p-0 */
        }
        .card-body.p-0 .table-responsive { /* Gère le cas p-0 */
            border-radius: 0 0 0.75rem 0.75rem;
            overflow: hidden;
        }

        /* --- Tableaux Admin --- */
        .table {
            /* surcharge potentielle de table-dark */
            --bs-table-bg: var(--fond-secondaire);
            --bs-table-border-color: var(--bordure-couleur);
            --bs-table-color: var(--texte-couleur);
            --bs-table-striped-bg: var(--fond-tertiaire); /* Si utilise table-striped */
            --bs-table-hover-bg: var(--fond-tertiaire); /* Hover plus subtil */
            --bs-table-hover-color: var(--texte-couleur);
            margin-bottom: 0; /* Retiré car géré par card-body p-0 */
        }
        .table thead th {
             font-weight: 600;
             color: var(--texte-secondaire);
             border-bottom-width: 1px; /* Ligne plus fine */
             font-size: 0.9rem;
             text-transform: uppercase;
             letter-spacing: 0.5px;
        }
        .table tbody td {
             vertical-align: middle;
             font-size: 0.95rem;
        }
        .table-hover tbody tr.hoverable-row:hover { /* Style pour lignes cliquables */
            background-color: var(--fond-tertiaire);
            cursor: pointer;
        }
        .table .text-danger { color: var(--danger-color) !important; }
        .table .text-warning { color: var(--warning-color) !important; }
        .table .text-muted { color: var(--texte-mute) !important; }


        /* --- Badges Statut --- */
        .status-badge {
            display: inline-block;
            padding: 0.3em 0.6em;
            font-size: 0.8rem;
            font-weight: 500;
            border-radius: 50px; /* Badge pilule */
            text-align: center;
            min-width: 80px; /* Largeur minimale */
        }
        /* Couleurs spécifiques par statut */
        .status-pending { /* En attente */
            background-color: rgba(var(--bs-warning-rgb), 0.15);
            color: var(--warning-color);
        }
        .status-processing { /* Validée, En cours, En préparation */
            background-color: rgba(var(--bs-primary-rgb), 0.15);
            color: var(--violet-principal);
        }
        .status-shipped { /* Expédiée */
             background-color: rgba(var(--violet-principal-rgb), 0.2); /* Plus clair */
             color: var(--violet-accent);
        }
        .status-delivered { /* Livrée, Terminé */
            background-color: rgba(var(--bs-success-rgb), 0.15);
            color: var(--success-color);
        }
        .status-cancelled { /* Annulée, Rejeté */
            background-color: rgba(var(--bs-danger-rgb), 0.15);
            color: var(--danger-color);
        }

        /* --- Boutons Admin --- */
        /* Utilise btn-outline-secondary pour un look neutre adaptable */
        .btn-outline-light { /* Surcharge pour admin si besoin */
            border-color: var(--bordure-couleur);
            color: var(--texte-secondaire);
        }
        .btn-outline-light:hover {
             background-color: var(--fond-tertiaire);
             border-color: var(--bordure-couleur);
             color: var(--texte-couleur);
        }

    </style>
{% endblock %}

{% block admin_content %}
<div class="row">
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="stat-card">
            <div class="stat-value">{{ stats.ca_total|default(0)|number_format(2, ',', ' ') }} €</div>
            <div class="stat-label">Chiffre d'affaires total</div>
            <div class="stat-icon"><i class="fas fa-euro-sign"></i></div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="stat-card">
            <div class="stat-value">{{ stats.ca_mois|default(0)|number_format(2, ',', ' ') }} €</div>
            <div class="stat-label">CA {{ "now"|date("F Y") }}</div> {# Mois/Année en cours #}
            <div class="progress-bar-admin" title="Objectif mensuel (exemple)">
                {% set progress_ca = (stats.ca_objectif_mois|default(1) > 0) ? ((stats.ca_mois|default(0) / stats.ca_objectif_mois|default(1)) * 100)|round(0, 'floor') : 0 %}
                {% set progress_ca_capped = progress_ca > 100 ? 100 : (progress_ca < 0 ? 0 : progress_ca) %}
                <div class="progress-value" style="width: {{ progress_ca_capped }}%"></div> {# Plafonne à 100% #}
            </div>
            <div class="stat-icon"><i class="fas fa-chart-line"></i></div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="stat-card">
            <div class="stat-value">{{ stats.total_commandes|default(0) }}</div>
            <div class="stat-label">Commandes totales</div>
            <div class="stat-icon"><i class="fas fa-shopping-cart"></i></div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="stat-card">
            <div class="stat-value">{{ stats.commandes_en_cours|default(0) }}</div>
            <div class="stat-label">Commandes en cours</div>
            <div class="progress-bar-admin">
                 {# Exemple: Progression basée sur un seuil ou juste visuel #}
                {% set progress_cmd = (stats.total_commandes|default(0) > 0) ? ((stats.commandes_en_cours|default(0) / stats.total_commandes) * 100)|round(0) : 0 %}
                {% set progress_cmd_capped = progress_cmd > 100 ? 100 : (progress_cmd < 0 ? 0 : progress_cmd) %}
                <div class="progress-value" style="width: {{ progress_cmd_capped }}%; background-color: var(--warning-color);"></div> {# Barre en orange #}
            </div>
            <div class="stat-icon"><i class="fas fa-truck-loading"></i></div> {# Icône changée #}
        </div>
    </div>
</div>

<div class="row">
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="stat-card">
            <div class="stat-value">{{ stats.total_clients|default(0) }}</div>
            <div class="stat-label">Clients inscrits</div>
            <div class="stat-icon"><i class="fas fa-users"></i></div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="stat-card">
            <div class="stat-value">{{ stats.nouveaux_clients|default(0) }}</div>
            <div class="stat-label">Nouveaux clients ce mois</div>
             <div class="progress-bar-admin">
                 {# Progression relative aux inscrits du mois précédent ou objectif ? #}
                 {% set progress_cli = (stats.total_clients|default(1) > 0) ? ((stats.nouveaux_clients|default(0) / (stats.total_clients|default(1))) * 50)|round(0) : 0 %} {# Exemple arbitraire #}
                {% set progress_cli_capped = progress_cli > 100 ? 100 : (progress_cli < 0 ? 0 : progress_cli) %}
                <div class="progress-value" style="width: {{ progress_cli_capped }}%; background-color: var(--success-color);"></div> {# Barre en vert #}
            </div>
            <div class="stat-icon"><i class="fas fa-user-plus"></i></div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="stat-card">
            <div class="stat-value">{{ stats.produits_actifs|default(0) }}</div>
            <div class="stat-label">Produits actifs</div>
            <div class="stat-icon"><i class="fas fa-boxes"></i></div> {# Icône changée #}
        </div>
    </div>
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="stat-card">
            <div class="stat-value">{{ stats.devis_attente|default(0) }}</div>
            <div class="stat-label">Devis en attente</div>
             <div class="progress-bar-admin">
                 {# Progression relative au total devis ou seuil ? #}
                 {% set progress_devis = (stats.devis_attente|default(0) > 5) ? 100 : ((stats.devis_attente|default(0) / 5) * 100) %} {# Exemple seuil 5 #}
                 {% set progress_devis_capped = progress_devis > 100 ? 100 : (progress_devis < 0 ? 0 : progress_devis) %}
                 <div class="progress-value" style="width: {{ progress_devis_capped }}%; background-color: var(--danger-color);"></div> {# Barre en rouge si > 5 #}
             </div>

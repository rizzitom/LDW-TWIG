{% block admin_scripts %}
    {{ parent() }} {# Inclut les scripts de base-admin.twig (important si Chart.js y est chargé) #}
    {# Supposer que Chart.js est déjà chargé par base-admin.twig #}
    {# <script src="https://cdn.jsdelivr.net/npm/chart.js"></script> #}
    <script>
        // Fonction pour récupérer une variable CSS
        function getCssVariable(variableName) {
            return getComputedStyle(document.documentElement).getPropertyValue(variableName).trim();
        }
        // Fonction pour convertir HEX/RGB en RGBA
         function colorToRgba(color, alpha = 1) {
            if (!color) return `rgba(0,0,0,${alpha})`; // Fallback
             if (color.startsWith('rgba')) return color; // Déjà RGBA
             if (color.startsWith('rgb')) { // Convertit rgb en rgba
                 return color.replace('rgb', 'rgba').replace(')', `, ${alpha})`);
             }
             if (color.startsWith('#')) { // Convertit HEX en rgba
                let hex = color.slice(1);
                if (hex.length === 3) {
                    hex = hex[0] + hex[0] + hex[1] + hex[1] + hex[2] + hex[2];
                }
                const r = parseInt(hex.substring(0, 2), 16);
                const g = parseInt(hex.substring(2, 4), 16);
                const b = parseInt(hex.substring(4, 6), 16);
                return `rgba(${r}, ${g}, ${b}, ${alpha})`;
            }
             return color; // Retourne tel quel si inconnu
         }


        function initCharts() {
            // Récupérer les couleurs du thème ACTUEL
            const primaryColor = getCssVariable('--violet-principal');
            const accentColor = getCssVariable('--violet-accent');
            const secondaryColor = getCssVariable('--violet-secondaire'); // Pourrait être utilisé pour doughnut
            const textColor = getCssVariable('--texte-secondaire'); // Pour labels/ticks
            const gridColor = getCssVariable('--bordure-couleur'); // Pour grilles
            const chartBgColor = getCssVariable('--fond-secondaire'); // Pour fond tooltip
            const tooltipTextColor = getCssVariable('--texte-couleur');

            // --- Graphique des ventes mensuelles ---
            const salesChartCtx = document.getElementById('salesChart');
            if (salesChartCtx && typeof Chart !== 'undefined') { // Vérifie existence et Chart.js chargé
                 // Détruire ancien graphique s'il existe (utile si rechargement AJAX ou changement thème)
                 let existingSalesChart = Chart.getChart(salesChartCtx);
                 if (existingSalesChart) { existingSalesChart.destroy(); }

                const salesChart = new Chart(salesChartCtx, {
                    type: 'line',
                    data: {
                        labels: {{ sales_data.monthly.labels|json_encode|raw|default('[]') }},
                        datasets: [{
                            label: 'Chiffre d\'affaires',
                            data: {{ sales_data.monthly.values|json_encode|raw|default('[]') }},
                            backgroundColor: colorToRgba(primaryColor, 0.2), // Utilise couleur thème avec alpha
                            borderColor: primaryColor, // Utilise couleur thème
                            borderWidth: 2,
                            pointBackgroundColor: primaryColor,
                            pointBorderColor: getCssVariable('--fond-secondaire'), // Fond du graphique pour bordure point
                            pointHoverBackgroundColor: getCssVariable('--fond-secondaire'),
                            pointHoverBorderColor: primaryColor,
                            pointRadius: 4,
                            pointHoverRadius: 6,
                            tension: 0.3 // Courbe adoucie
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: {
                                beginAtZero: true,
                                grid: { color: gridColor },
                                ticks: {
                                    color: textColor,
                                    callback: function(value) {
                                        // Format monétaire €
                                        return new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR', minimumFractionDigits: 0, maximumFractionDigits: 0 }).format(value);
                                    }
                                }
                            },
                            x: {
                                grid: { color: gridColor },
                                ticks: { color: textColor }
                            }
                        },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                mode: 'index',
                                intersect: false,
                                backgroundColor: chartBgColor,
                                titleColor: accentColor, // Titre tooltip en accent
                                bodyColor: tooltipTextColor,
                                borderColor: gridColor,
                                borderWidth: 1,
                                padding: 10,
                                callbacks: {
                                    label: function(context) {
                                        let label = context.dataset.label || '';
                                        if (label) { label += ': '; }
                                        label += new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' }).format(context.parsed.y);
                                        return label;
                                    }
                                }
                            }
                        }
                    }
                });
            } else if (!salesChartCtx) {
                 console.warn("Element canvas 'salesChart' non trouvé.");
            } else if (typeof Chart === 'undefined') {
                 console.warn("Chart.js n'est pas chargé.");
            }

            // --- Graphique des ventes par catégorie ---
            const categoriesChartCtx = document.getElementById('categoriesChart');
            if (categoriesChartCtx && typeof Chart !== 'undefined') {
                 let existingCategoriesChart = Chart.getChart(categoriesChartCtx);
                 if (existingCategoriesChart) { existingCategoriesChart.destroy(); }

                // Palette de couleurs dérivée du thème
                 const categoryColors = [
                     primaryColor,
                     accentColor,
                     secondaryColor,
                     colorToRgba(primaryColor, 0.7),
                     colorToRgba(accentColor, 0.7),
                     colorToRgba(secondaryColor, 0.7)
                     // Ajoutez plus de couleurs si nécessaire
                 ];

                const categoriesChart = new Chart(categoriesChartCtx, {
                    type: 'doughnut',
                    data: {
                        labels: {{ sales_data.categories.labels|json_encode|raw|default('[]') }},
                        datasets: [{
                            data: {{ sales_data.categories.values|json_encode|raw|default('[]') }},
                            backgroundColor: categoryColors,
                            borderColor: getCssVariable('--fond-secondaire'), // Bordure couleur fond
                            borderWidth: 3, // Augmente bordure pour effet visuel
                            hoverOffset: 8 // Décalage au survol
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'right', // Légende à droite
                                labels: {
                                    color: textColor,
                                    padding: 15, // Espace légende
                                    boxWidth: 12,
                                    usePointStyle: true, // Utilise cercles
                                    font: { size: 11 }
                                }
                            },
                            tooltip: {
                                 backgroundColor: chartBgColor,
                                 titleColor: accentColor,
                                 bodyColor: tooltipTextColor,
                                 borderColor: gridColor,
                                 borderWidth: 1,
                                 padding: 10,
                                callbacks: {
                                    label: function(context) {
                                        let label = context.label || '';
                                        if (label) { label += ': '; }
                                        label += new Intl.NumberFormat('fr-FR', { style: 'currency', currency: 'EUR' }).format(context.parsed);
                                        // Optionnel: Ajouter pourcentage
                                        // const total = context.chart.data.datasets[0].data.reduce((a, b) => a + b, 0);
                                        // const percentage = ((context.parsed / total) * 100).toFixed(1) + '%';
                                        // label += ` (${percentage})`;
                                        return label;
                                    }
                                }
                            }
                        },
                         cutout: '65%' // Fait un doughnut plus fin
                    }
                });
            } else if (!categoriesChartCtx) {
                 console.warn("Element canvas 'categoriesChart' non trouvé.");
            } else if (typeof Chart === 'undefined') {
                 console.warn("Chart.js n'est pas chargé.");
            }
        }

        // Initialise les graphiques au chargement
        initCharts();

        // Optionnel: Réinitialiser les graphiques si le thème change (si le changement de thème ne recharge pas la page)
        // Supposer qu'il y a un event 'themeChanged' déclenché par le script de base.twig
        // document.body.addEventListener('themeChanged', initCharts);

    </script>
{% endblock %}

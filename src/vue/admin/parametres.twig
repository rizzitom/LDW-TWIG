<script>
    // Script de démonstration pour les paramètres
    document.addEventListener('DOMContentLoaded', function() {
        // Gestion des boutons de sauvegarde
        const saveButtons = document.querySelectorAll('.save-section-btn');
        saveButtons.forEach(button => {
            button.addEventListener('click', function() {
                // Simuler une sauvegarde
                const originalText = button.innerHTML;
                button.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Enregistrement...';
                button.disabled = true;
                
                setTimeout(() => {
                    button.innerHTML = '<i class="fas fa-check me-1"></i> Enregistré !';
                    setTimeout(() => {
                        button.innerHTML = originalText;
                        button.disabled = false;
                    }, 1500);
                }, 1000);
            });
        });
        
        // Bouton pour enregistrer tous les paramètres
        document.getElementById('saveAllSettings').addEventListener('click', function() {
            const button = this;
            const originalText = button.innerHTML;
            button.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Enregistrement de tous les paramètres...';
            button.disabled = true;
            
            setTimeout(() => {
                button.innerHTML = '<i class="fas fa-check me-1"></i> Tous les paramètres ont été enregistrés !';
                setTimeout(() => {
                    button.innerHTML = originalText;
                    button.disabled = false;
                }, 2000);
            }, 1500);
        });
    });
</script>

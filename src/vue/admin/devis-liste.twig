{% extends "admin/base-admin.twig" %}

{% block admin_title %}Gestion des demandes de devis{% endblock %}

{% block admin_actions %}
<a href="index.php?page=admin" class="btn btn-outline-light me-2">
    <i class="fas fa-arrow-left me-2"></i> Retour au tableau de bord
</a>
{% endblock %}

{% block admin_content %}
<!-- Filtres -->
<div class="filter-section mb-4">
    <form action="index.php" method="get" class="row g-3">
        <input type="hidden" name="page" value="admin">
        <input type="hidden" name="section" value="devis">
        
        <div class="col-md-3">
            <label for="statut" class="form-label">Statut</label>
            <select name="statut" id="statut" class="form-select search-admin">
                <option value="">Tous les statuts</option>
                <option value="en_attente" {% if filtres.statut == 'en_attente' %}selected{% endif %}>En attente</option>
                <option value="en_cours" {% if filtres.statut == 'en_cours' %}selected{% endif %}>En cours</option>
                <option value="termine" {% if filtres.statut == 'termine' %}selected{% endif %}>Terminé</option>
                <option value="rejete" {% if filtres.statut == 'rejete' %}selected{% endif %}>Rejeté</option>
            </select>
        </div>
        
        <div class="col-md-3">
            <label for="service" class="form-label">Service</label>
            <select name="service" id="service" class="form-select search-admin">
                <option value="">Tous les services</option>
                {% for service in services %}
                <option value="{{ service.id }}" {% if filtres.service == service.id|string %}selected{% endif %}>{{ service.nom }}</option>
                {% endfor %}
            </select>
        </div>
        
        <div class="col-md-3">
            <label for="date_debut" class="form-label">Date de début</label>
            <input type="date" class="form-control search-admin" id="date_debut" name="date_debut" value="{{ filtres.date_debut }}">
        </div>
        
        <div class="col-md-3">
            <label for="date_fin" class="form-label">Date de fin</label>
            <input type="date" class="form-control search-admin" id="date_fin" name="date_fin" value="{{ filtres.date_fin }}">
        </div>
        
        <div class="col-12 text-end mt-4">
            <button type="submit" class="btn btn-purple">
                <i class="fas fa-filter me-2"></i> Filtrer
            </button>
            <a href="index.php?page=admin&section=devis" class="btn btn-outline-light ms-2">
                <i class="fas fa-undo me-2"></i> Réinitialiser
            </a>
        </div>
    </form>
</div>

<!-- Liste des devis -->
<div class="admin-table">
    <div class="table-responsive">
        <table class="table table-dark table-hover mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Service</th>
                    <th>Client</th>
                    <th>Date demande</th>
                    <th>Statut</th>
                    <th>Montant estimé</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% if devis|length > 0 %}
                    {% for d in devis %}
                    <tr>
                        <td>{{ d.id }}</td>
                        <td>{{ d.service_nom }}</td>
                        <td>
                            {{ d.nom }} {{ d.prenom }}<br>
                            <small class="text-muted">{{ d.email }}</small>
                        </td>
                        <td>{{ d.date_demande|date("d/m/Y H:i") }}</td>
                        <td>
                            {% if d.statut == 'en_attente' %}
                                <span class="status-badge status-pending">En attente</span>
                            {% elseif d.statut == 'en_cours' %}
                                <span class="status-badge status-processing">En cours</span>
                            {% elseif d.statut == 'termine' %}
                                <span class="status-badge status-delivered">Terminé</span>
                            {% elseif d.statut == 'rejete' %}
                                <span class="status-badge status-cancelled">Rejeté</span>
                            {% endif %}
                        </td>
                        <td>
                            {% if d.montant_estime %}
                                {{ d.montant_estime|number_format(2, ',', ' ') }} €
                            {% else %}
                                <span class="text-muted">Non défini</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="d-flex">
                                <a href="index.php?page=admin&section=devis-detail&id={{ d.id }}" 
                                   class="btn btn-sm btn-outline-light me-2" title="Voir les détails">
                                    <i class="fas fa-eye"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-primary" 
                                        data-bs-toggle="modal" data-bs-target="#updateStatusModal" 
                                        data-id="{{ d.id }}" 
                                        data-status="{{ d.statut }}" 
                                        data-service="{{ d.service_nom }}"
                                        title="Modifier le statut">
                                    <i class="fas fa-edit"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center py-4">
                            <i class="fas fa-file-invoice fa-3x mb-3 text-muted"></i>
                            <p>Aucune demande de devis trouvée</p>
                        </td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
    </div>
</div>

{% if pagination.nombre_pages > 1 %}
<nav aria-label="Page navigation" class="mt-4">
    <ul class="pagination pagination-admin">
        {% if pagination.page_courante > 1 %}
        <li class="page-item">
            <a class="page-link" href="index.php?page=admin&section=devis&page_num={{ pagination.page_courante - 1 }}{% for key, value in filtres %}{% if value %}{{ '&' ~ key ~ '=' ~ value }}{% endif %}{% endfor %}" aria-label="Précédent">
                <span aria-hidden="true">&laquo;</span>
            </a>
        </li>
        {% endif %}
        
        {% for i in range(1, pagination.nombre_pages) %}
        <li class="page-item {% if i == pagination.page_courante %}active{% endif %}">
            <a class="page-link" href="index.php?page=admin&section=devis&page_num={{ i }}{% for key, value in filtres %}{% if value %}{{ '&' ~ key ~ '=' ~ value }}{% endif %}{% endfor %}">{{ i }}</a>
        </li>
        {% endfor %}
        
        {% if pagination.page_courante < pagination.nombre_pages %}
        <li class="page-item">
            <a class="page-link" href="index.php?page=admin&section=devis&page_num={{ pagination.page_courante + 1 }}{% for key, value in filtres %}{% if value %}{{ '&' ~ key ~ '=' ~ value }}{% endif %}{% endfor %}" aria-label="Suivant">
                <span aria-hidden="true">&raquo;</span>
            </a>
        </li>
        {% endif %}
    </ul>
</nav>
{% endif %}
{% endblock %}

{% block admin_modals %}
<!-- Modal de changement de statut -->
<div class="modal fade modal-admin" id="updateStatusModal" tabindex="-1" aria-labelledby="updateStatusModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="updateStatusModalLabel">Modifier le statut du devis</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <form action="" method="post" id="updateStatusForm">
                <div class="modal-body">
                    <p>Service : <strong id="quoteService"></strong></p>
                    <div class="mb-3">
                        <label for="statut" class="form-label">Nouveau statut</label>
                        <select class="form-select" id="statutInput" name="statut" required>
                            <option value="en_attente">En attente</option>
                            <option value="en_cours">En cours</option>
                            <option value="termine">Terminé</option>
                            <option value="rejete">Rejeté</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label for="montantInput" class="form-label">Montant estimé (€)</label>
                        <input type="number" step="0.01" min="0" class="form-control" id="montantInput" name="montant_estime" placeholder="Montant (optionnel)">
                    </div>
                    <div class="mb-3">
                        <label for="notesInput" class="form-label">Notes (interne)</label>
                        <textarea class="form-control" id="notesInput" name="notes_admin" rows="3" placeholder="Notes internes sur ce devis"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-purple">Mettre à jour</button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

{% block admin_scripts %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Configuration du modal de changement de statut
        const statusModal = document.getElementById('updateStatusModal');
        if (statusModal) {
            statusModal.addEventListener('show.bs.modal', function(event) {
                const button = event.relatedTarget;
                const id = button.getAttribute('data-id');
                const currentStatus = button.getAttribute('data-status');
                const service = button.getAttribute('data-service');
                
                document.getElementById('quoteService').textContent = service;
                document.getElementById('statutInput').value = currentStatus;
                document.getElementById('updateStatusForm').action = 'index.php?page=admin&section=devis-detail&id=' + id;
            });
        }
    });
</script>
{% endblock %}

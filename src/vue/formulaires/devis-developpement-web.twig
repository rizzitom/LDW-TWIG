<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Gestion de la navigation entre les étapes
        const form = document.getElementById('devis-form');
        const sections = document.querySelectorAll('.form-section');
        const stepItems = document.querySelectorAll('.devis-step-item');
        
        // Fonction pour valider un email
        function validateEmail(email) {
            const re = /^(([^<>()\[\]\\.,;:\s@"]+(\.[^<>()\[\]\\.,;:\s@"]+)*)|(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
            return re.test(String(email).toLowerCase());
        }
        
        // Fonction pour valider les champs requis dans une section
        function validateSection(section) {
            const requiredFields = section.querySelectorAll('[required]');
            let isValid = true;
            let firstInvalidField = null;
            
            requiredFields.forEach(field => {
                let fieldValid = true;
                
                if (field.type === 'email') {
                    fieldValid = field.value.trim() !== '' && validateEmail(field.value);
                } else if (field.type === 'checkbox') {
                    fieldValid = field.checked;
                } else {
                    fieldValid = field.value.trim() !== '';
                }
                
                if (!fieldValid) {
                    field.classList.add('is-invalid');
                    isValid = false;
                    
                    // Mémoriser le premier champ invalide pour le focus
                    if (!firstInvalidField) {
                        firstInvalidField = field;
                    }
                    
                    // Ajouter une animation de secousse au champ invalide
                    field.style.animation = 'none';
                    setTimeout(() => {
                        field.style.animation = 'shake 0.5s';
                    }, 10);
                } else {
                    field.classList.remove('is-invalid');
                }
            });
            
            if (!isValid && firstInvalidField) {
                firstInvalidField.focus();
                
                // Afficher un message d'erreur contextuel
                const errorMessage = document.createElement('div');
                errorMessage.className = 'form-error-tooltip';
                errorMessage.textContent = 'Ce champ est requis';
                
                // Si l'erreur est sur un email invalide
                if (firstInvalidField.type === 'email' && firstInvalidField.value.trim() !== '') {
                    errorMessage.textContent = 'Adresse email invalide';
                }
                
                // Positionner le message d'erreur
                const fieldRect = firstInvalidField.getBoundingClientRect();
                errorMessage.style.top = `${fieldRect.top + window.scrollY - 30}px`;
                errorMessage.style.left = `${fieldRect.left + fieldRect.width / 2}px`;
                
                document.body.appendChild(errorMessage);
                
                // Supprimer le message après 3 secondes
                setTimeout(() => {
                    errorMessage.style.opacity = '0';
                    setTimeout(() => {
                        document.body.removeChild(errorMessage);
                    }, 300);
                }, 3000);
            }
            
            return isValid;
        }
        
        // Boutons suivant
        document.querySelectorAll('.btn-next').forEach(button => {
            button.addEventListener('click', function() {
                const nextStep = this.getAttribute('data-next');
                const currentSection = this.closest('.form-section');
                
                // Valider les champs de l'étape actuelle
                if (!validateSection(currentSection)) {
                    return;
                }
                
                // Animation de sortie de la section actuelle
                currentSection.style.animation = 'sectionExit 0.3s forwards';
                
                setTimeout(() => {
                    // Masquer toutes les sections et désactiver tous les indicateurs d'étape
                    sections.forEach(section => section.style.display = 'none');
                    
                    // Afficher la section suivante avec animation d'entrée
                    const nextSection = document.getElementById('step-' + nextStep);
                    nextSection.style.display = 'block';
                    nextSection.style.animation = 'sectionEntry 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards';
                    
                    // Mise à jour des indicateurs d'étape
                    stepItems.forEach(item => item.classList.remove('active'));
                    document.querySelector(`.devis-step-item[data-step="${nextStep}"]`).classList.add('active');
                    
                    // Marquer l'étape précédente comme complétée
                    const prevStep = parseInt(nextStep) - 1;
                    document.querySelector(`.devis-step-item[data-step="${prevStep}"]`).classList.add('completed');
                    
                    // Scroll vers le haut du formulaire
                    window.scrollTo({
                        top: form.offsetTop - 100,
                        behavior: 'smooth'
                    });
                }, 300);
            });
        });
        
        // Boutons précédent
        document.querySelectorAll('.btn-prev').forEach(button => {
            button.addEventListener('click', function() {
                if (this.tagName === 'A') return; // Ignorer si c'est un lien (retour à la page devis)
                
                const prevStep = this.getAttribute('data-prev');
                const currentSection = this.closest('.form-section');
                
                // Animation de sortie de la section actuelle
                currentSection.style.animation = 'sectionExitReverse 0.3s forwards';
                
                setTimeout(() => {
                    // Masquer toutes les sections
                    sections.forEach(section => section.style.display = 'none');
                    
                    // Afficher la section précédente avec animation d'entrée
                    const prevSection = document.getElementById('step-' + prevStep);
                    prevSection.style.display = 'block';
                    prevSection.style.animation = 'sectionEntryReverse 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards';
                    
                    // Mise à jour des indicateurs d'étape
                    stepItems.forEach(item => item.classList.remove('active'));
                    document.querySelector(`.devis-step-item[data-step="${prevStep}"]`).classList.add('active');
                    
                    // Scroll vers le haut du formulaire
                    window.scrollTo({
                        top: form.offsetTop - 100,
                        behavior: 'smooth'
                    });
                }, 300);
            });
        });
        
        // Navigation directe en cliquant sur les étapes
        stepItems.forEach(item => {
            item.addEventListener('click', function() {
                const step = this.getAttribute('data-step');
                
                // Vérifier si l'étape est déjà complétée ou active
                if (this.classList.contains('completed') || this.classList.contains('active')) {
                    // Masquer toutes les sections et désactiver tous les indicateurs d'étape
                    sections.forEach(section => section.style.display = 'none');
                    stepItems.forEach(item => item.classList.remove('active'));
                    
                    // Afficher la section sélectionnée et activer l'indicateur d'étape correspondant
                    document.getElementById('step-' + step).style.display = 'block';
                    this.classList.add('active');
                    
                    // Scroll vers le haut du formulaire
                    window.scrollTo({
                        top: form.offsetTop - 100,
                        behavior: 'smooth'
                    });
                }
            });
        });
        
        // Fonction pour vérifier si tous les champs requis sont remplis
        function checkAllRequired() {
            let allFilled = true;
            
            // Parcourir tous les champs requis du formulaire
            document.querySelectorAll('#devis-form [required]').forEach(field => {
                if (field.type === 'checkbox') {
                    if (!field.checked) allFilled = false;
                } else {
                    if (!field.value.trim()) allFilled = false;
                }
            });
            
            // Ajouter/supprimer la classe 'ready' au bouton de soumission
            const submitBtn = document.getElementById('submitBtn');
            if (allFilled) {
                submitBtn.classList.add('ready');
            } else {
                submitBtn.classList.remove('ready');
            }
            
            return allFilled;
        }
        
        // Vérifier l'état initial des champs requis
        checkAllRequired();
        
        // Écouter les changements sur tous les champs requis
        document.querySelectorAll('#devis-form [required]').forEach(field => {
            field.addEventListener('change', checkAllRequired);
            field.addEventListener('input', checkAllRequired);
        });
        
        // Gestion de la soumission du formulaire avec animation améliorée
        form.addEventListener('submit', function(e) {
            // Vérifier que la case des conditions est cochée
            const acceptTerms = document.getElementById('accept_terms');
            const conditionsHidden = document.getElementById('conditions_hidden');
            
            if (acceptTerms.checked) {
                conditionsHidden.value = 'oui';
            } else {
                e.preventDefault();
                acceptTerms.classList.add('is-invalid');
                
                // Effet de secousse sur la case à cocher
                const termsContainer = document.querySelector('.terms-container');
                termsContainer.style.animation = 'none';
                setTimeout(() => {
                    termsContainer.style.animation = 'shake 0.5s';
                }, 10);
                
                // Message d'erreur plus visuel
                const errorToast = document.createElement('div');
                errorToast.className = 'error-toast animate__animated animate__fadeInUp';
                errorToast.innerHTML = '<i class="fas fa-exclamation-circle"></i> Veuillez accepter les conditions pour continuer';
                document.body.appendChild(errorToast);
                
                setTimeout(() => {
                    errorToast.classList.add('animate__fadeOutDown');
                    setTimeout(() => {
                        document.body.removeChild(errorToast);
                    }, 500);
                }, 3000);
                
                return false;
            }
            
            // Valider tous les champs requis du formulaire
            let isValid = true;
            sections.forEach(section => {
                if (!validateSection(section)) {
                    isValid = false;
                    section.style.display = 'block';
                }
            });
            
            if (!isValid) {
                e.preventDefault();
                return false;
            }
            
            // Animation de chargement sur le bouton de soumission
            const submitBtn = document.getElementById('submitBtn');
            submitBtn.innerHTML = '<div class="spinner"><div class="bounce1"></div><div class="bounce2"></div><div class="bounce3"></div></div> Envoi en cours...';
            submitBtn.disabled = true;
            submitBtn.classList.add('submitting');
            
            // Overlay de soumission pour une meilleure UX
            const overlay = document.createElement('div');
            overlay.className = 'submit-overlay animate__animated animate__fadeIn';
            overlay.innerHTML = `
                <div class="submit-status">
                    <div class="spinner-ring"></div>
                    <p>Envoi de votre demande en cours...</p>
                    <p class="submit-hint">Veuillez patienter, ne fermez pas cette page</p>
                </div>
            `;
            document.body.appendChild(overlay);
            
            // Laisser le formulaire se soumettre naturellement
            return true;
        });
    });

    // --- Dynamique fonctionnalités selon le type de projet ---
    document.addEventListener('DOMContentLoaded', function() {
        // Liste complète des fonctionnalités
        const allFeatures = [
            { id: "responsive", label: "Design responsive" },
            { id: "admin", label: "Interface d'administration" },
            { id: "blog", label: "Blog/Actualités" },
            { id: "newsletter", label: "Newsletter" },
            { id: "multilingue", label: "Multilingue" },
            { id: "paiement", label: "Système de paiement" },
            { id: "reservation", label: "Système de réservation" },
            { id: "membres", label: "Espace membres" },
            { id: "seo", label: "Optimisation SEO avancée" },
            { id: "social", label: "Intégration réseaux sociaux" },
            { id: "chat", label: "Chat en ligne / Support" },
            { id: "galerie", label: "Galerie / Portfolio" },
            { id: "contact_avance", label: "Formulaire de contact avancé" },
            { id: "api", label: "Intégration API tierces (Google Maps, etc.)" },
            { id: "catalogue", label: "Gestion de catalogue/produits" },
            { id: "avis", label: "Système d'avis/commentaires" },
            { id: "espace_client", label: "Espace client/documentation" },
            { id: "rgpd", label: "Conformité RGPD / Gestion des cookies" },
            { id: "maintenance", label: "Hébergement & maintenance" },
            { id: "backup", label: "Sauvegarde automatique" },
            { id: "analytics", label: "Analytics / Statistiques" },
            { id: "notifications", label: "Système de notifications" },
            { id: "accessibilite", label: "Accessibilité (RGAA/WCAG)" },
            { id: "autre", label: "Autre (précisez ci-dessous)" }
        ];

        // Fonctionnalités populaires par type de projet
        const featuresByType = {
            site_vitrine: ["responsive", "admin", "blog", "galerie", "contact_avance", "seo", "social", "multilingue", "rgpd"],
            site_ecommerce: ["responsive", "admin", "paiement", "catalogue", "membres", "newsletter", "avis", "analytics", "social", "seo", "rgpd", "maintenance"],
            application_web: ["responsive", "admin", "membres", "notifications", "chat", "api", "analytics", "backup", "accessibilite", "maintenance"],
            application_mobile: ["responsive", "membres", "notifications", "chat", "api", "analytics", "backup", "accessibilite"],
            refonte_site: ["responsive", "admin", "blog", "galerie", "contact_avance", "seo", "social", "multilingue", "rgpd", "maintenance"],
            autre: ["responsive", "admin", "api", "analytics", "backup", "accessibilite", "autre"]
        };

        // Récupérer les fonctionnalités déjà cochées (si retour formulaire)
        let checkedFeatures = [];
        {% if post_data.fonctionnalites is defined %}
            checkedFeatures = {{ post_data.fonctionnalites|json_encode|raw }};
        {% endif %}

        // Génère le HTML des cases à cocher
        function renderFeatures(featureIds, showAll = false) {
            const group = document.getElementById('fonctionnalites-checkbox-group');
            group.innerHTML = '';
            let featuresToShow = showAll
                ? allFeatures
                : allFeatures.filter(f => featureIds.includes(f.id));
            // Toujours afficher "autre" en dernier
            featuresToShow = featuresToShow.filter(f => f.id !== "autre");
            if (!showAll && allFeatures.find(f => f.id === "autre")) {
                featuresToShow.push(allFeatures.find(f => f.id === "autre"));
            }
            featuresToShow.forEach(f => {
                const checked = checkedFeatures.includes(f.id) ? 'checked' : '';
                const inputId = "fonc_" + f.id;
                // Utiliser <label> englobant pour rendre toute la case cliquable
                const html = `
                    <label class="checkbox-item" tabindex="0">
                        <input type="checkbox" id="${inputId}" name="fonctionnalites[]" value="${f.id}" ${checked}>
                        <span>${f.label}</span>
                    </label>
                `;
                group.insertAdjacentHTML('beforeend', html);
            });
        }

        // Initialisation : afficher les fonctionnalités selon le type sélectionné ou tout si rien
        const typeProjet = document.getElementById('type_projet');
        const showAllBtn = document.getElementById('show-all-fonctionnalites');
        let allShown = false;

        function updateFeatures() {
            if (allShown) {
                renderFeatures([], true);
                showAllBtn.textContent = "Voir moins de fonctionnalités";
            } else {
                const type = typeProjet.value;
                if (featuresByType[type]) {
                    renderFeatures(featuresByType[type]);
                } else {
                    // Si aucun type sélectionné, afficher les plus populaires globales
                    renderFeatures(["responsive", "admin", "blog", "paiement", "catalogue", "seo", "social", "membres", "newsletter", "autre"]);
                }
                showAllBtn.textContent = "Voir toutes les fonctionnalités";
            }
        }

        typeProjet.addEventListener('change', function() {
            allShown = false;
            updateFeatures();
        });

        showAllBtn.addEventListener('click', function() {
            allShown = !allShown;
            updateFeatures();
        });

        // Premier affichage
        updateFeatures();
    });
</script>

<style>
    /* Animations supplémentaires */
    @keyframes sectionExit {
        from { opacity: 1; transform: translateX(0); }
        to { opacity: 0; transform: translateX(-50px); }
    }
    
    @keyframes sectionExitReverse {
        from { opacity: 1; transform: translateX(0); }
        to { opacity: 0; transform: translateX(50px); }
    }
    
    @keyframes sectionEntryReverse {
        from { opacity: 0; transform: translateX(-50px); }
        to { opacity: 1; transform: translateX(0); }
    }
    
    @keyframes shake {
        0%, 100% { transform: translateX(0); }
        10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
        20%, 40%, 60%, 80% { transform: translateX(5px); }
    }
    
    /* Style pour la bulle d'erreur */
    .form-error-tooltip {
        position: absolute;
        background-color: #dc3545;
        color: white;
        padding: 5px 10px;
        border-radius: 4px;
        font-size: 0.8rem;
        pointer-events: none;
        z-index: 1000;
        transform: translateX(-50%);
        opacity: 1;
        transition: opacity 0.3s;
    }
    
    .form-error-tooltip::after {
        content: '';
        position: absolute;
        top: 100%;
        left: 50%;
        margin-left: -5px;
        border-width: 5px;
        border-style: solid;
        border-color: #dc3545 transparent transparent transparent;
    }
    
    /* Styles améliorés pour les champs invalides */
    .form-control.is-invalid, .form-select.is-invalid {
        border-color: #dc3545;
        box-shadow: 0 0 0 0.25rem rgba(220, 53, 69, 0.25);
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath stroke-linejoin='round' d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right calc(0.375em + 0.1875rem) center;
        background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
    }
    
    input[type="checkbox"].is-invalid {
        outline: 2px solid #dc3545;
        border-radius: 3px;
    }
</style>
{% endblock %}

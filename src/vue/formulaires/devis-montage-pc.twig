                    </div>
                    
                    <div class="form-group mb-0">
                        <label for="stockage_capacite">Capacité totale souhaitée</label>
                        <select class="form-control" id="stockage_capacite" name="stockage_capacite">
                            <option value="">Sélectionnez une option</option>
                            <option value="500">500 Go</option>
                            <option value="1000">1 To</option>
                            <option value="2000">2 To</option>

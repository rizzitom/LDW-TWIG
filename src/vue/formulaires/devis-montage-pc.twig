{% extends 'base.twig' %}

{% block title %}Demande de devis - PC sur Mesure{% endblock %}

{% block head %}
    {{ parent() }}
    <style>
        /* ============================================== */
        /* STYLES FORMULAIRE DEVIS                 */
        /* ============================================== */
        
        .devis-form-container {
            max-width: 800px;
            margin: 2rem auto;
            padding: 2rem;
            border-radius: 10px;
            box-shadow: 0 4px 20px var(--ombre-couleur);
            background-color: var(--fond-secondaire);
            border: 1px solid var(--bordure-couleur);
        }
        
        .form-section {
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid var(--bordure-couleur);
        }
        
        .form-section:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }
        
        .form-section h3 {
            color: var(--violet-principal);
            margin-bottom: 1rem;
            font-size: 1.3rem;
            font-weight: 600;
        }
        
        .form-group {
            margin-bottom: 1.5rem;
        }
        
        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 500;
            color: var(--texte-couleur);
        }
        
        .form-control {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid var(--bordure-couleur);
            border-radius: 5px;
            font-size: 1rem;
            background-color: var(--fond-tertiaire);
            color: var(--texte-couleur);
            transition: border-color 0.3s, box-shadow 0.3s;
        }
        
        .form-control:focus {
            border-color: var(--violet-principal);
            outline: none;
            box-shadow: 0 0 0 2px rgba(var(--violet-principal-rgb), 0.2);
        }
        
        .form-control::placeholder {
            color: var(--texte-mute);
        }
        
        .checkbox-group {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem;
        }
        
        .checkbox-item {
            display: flex;
            align-items: center;
            width: calc(50% - 0.5rem);
        }
        
        .checkbox-item input {
            margin-right: 0.5rem;
        }
        
        .radio-group {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }
        
        .radio-item {
            display: flex;
            align-items: center;
        }
        
        .radio-item input {
            margin-right: 0.5rem;
        }
        
        .form-submit {
            background-color: var(--violet-principal);
            color: white;
            border: none;
            padding: 0.8rem 1.5rem;
            font-size: 1rem;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s, transform 0.2s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }
        
        .form-submit:hover {
            background-color: var(--violet-secondaire);
            transform: translateY(-2px);
        }
        
        .form-submit:active {
            transform: translateY(0);
        }
        
        .required:after {
            content: " *";
            color: #e32;
            font-weight: bold;
        }
        
        .form-text {
            font-size: 0.85rem;
            color: var(--texte-secondaire);
            margin-top: 0.5rem;
        }
        
        .terms-container {
            background-color: var(--fond-tertiaire);
            padding: 1rem;
            border-radius: 5px;
            margin-bottom: 1.5rem;
            border: 1px solid var(--bordure-couleur);
        }
        
        .terms-checkbox {
            display: flex;
            align-items: flex-start;
            margin-top: 0.5rem;
        }
        
        .terms-checkbox input {
            margin-right: 0.5rem;
            margin-top: 0.3rem;
        }
        
        .range-container {
            padding: 0.5rem 0;
        }
        
        .range-labels {
            display: flex;
            justify-content: space-between;
            margin-top: 0.5rem;
            font-size: 0.85rem;
            color: var(--texte-secondaire);
        }
        
        .component-card {
            background-color: var(--fond-tertiaire);
            border: 1px solid var(--bordure-couleur);
            border-radius: 5px;
            padding: 1rem;
            margin-bottom: 1rem;
        }
        
        .component-card h4 {
            color: var(--violet-accent);
            font-size: 1.1rem;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
        }
        
        .component-card h4 i {
            margin-right: 0.5rem;
        }
        
        @media (max-width: 768px) {
            .checkbox-item {
                width: 100%;
            }
            
            .devis-form-container {
                padding: 1.5rem;
                margin: 1rem;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="container">

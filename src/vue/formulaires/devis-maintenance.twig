                <h3><i class="fas fa-tools me-2"></i>Vos besoins en maintenance</h3>
                
                <div class="form-group">
                    <label for="type_maintenance" class="required">Type de maintenance souhaitée</label>
                    <select class="form-control" id="type_maintenance" name="type_maintenance" required>
                        <option value="">Sélectionnez une option</option>
                        <option value="depannage_ponctuel">Dépannage ponctuel</option>
                        <option value="maintenance_preventive">Maintenance préventive régulière</option>
                        <option value="contrat_maintenance">Contrat de maintenance</option>
                        <option value="assistance_distance">Assistance à distance</option>
                        <option value="formation">Formation et conseils</option>

<!DOCTYPE html>
{# Prépare la variable pour le thème initial (sera réellement appliquée par JS) #}
{% set initial_theme = 'dark' %} {# Défaut sombre #}
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Le Design Du Web{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    {# <link rel="stylesheet" href="/public/css/modern-styles.css"> #} {# Si vous avez des styles additionnels #}

    <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="https://kit.fontawesome.com/969792f3e4.js" crossorigin="anonymous"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/animate.css@4.1.1/animate.min.css"/>
<link rel="stylesheet" href="{{ asset('css/order-styles.css') }}"/>

    <style>
        /* ============================================== */
        /* VARIABLES CSS THEME LDW               */
        /* ============================================== */
        :root {
            /* --- Couleurs de Base --- */
            --violet-principal: #8A2BE2;
            --violet-principal-rgb: 138, 43, 226; /* Pour rgba() */
            --violet-secondaire: #5D19A8;
            --violet-accent: #BB86FC;
            --white: #FFFFFF;
            --black: #000000;
            --success-color: #4CAF50; /* Vert succès */
            --danger-color: #dc3545;  /* Rouge danger */
            --warning-color: #ff9800; /* Orange avertissement */
            --link-color-special: #e91e63; /* Pour l'icône coeur, si besoin */

            /* --- Mode Sombre (Défaut) --- */
            --fond-primaire: #121212;
            --fond-primaire-rgb: 18, 18, 18; /* Pour rgba() */
            --fond-secondaire: #1e1e1e;
            --fond-tertiaire: #2a2a2e;
            --texte-couleur: var(--white);
            --texte-secondaire: rgba(255, 255, 255, 0.7);
            --texte-mute: rgba(255, 255, 255, 0.5);
            --bordure-couleur: rgba(255, 255, 255, 0.1);
            --ombre-couleur: rgba(0, 0, 0, 0.3);
            --logo-image: url('{{ asset("images/logov2/Logosfblanc.png") }}');

            /* --- Variables Bootstrap (Sombre) --- */
            --bs-primary: var(--violet-principal);
            --bs-primary-rgb: var(--violet-principal-rgb);
            --bs-secondary: var(--violet-secondaire);
            --bs-secondary-rgb: 93, 25, 168;
            --bs-body-color: var(--texte-couleur);
            --bs-body-bg: var(--fond-primaire);
            --bs-link-color: var(--violet-accent);
            --bs-link-hover-color: var(--texte-couleur);
            --bs-border-color: var(--bordure-couleur);
            --bs-light-rgb: 255, 255, 255;
            --bs-dark-rgb: 18, 18, 18;
             /* Couleurs alertes BS */
            --bs-success-rgb: 76, 175, 80;
            --bs-danger-rgb: 220, 53, 69;
            --bs-warning-rgb: 255, 152, 0;
        }

        /* --- Mode Clair --- */
        body.light-theme {
            --fond-primaire: #f8f9fa;
            --fond-primaire-rgb: 248, 249, 250; /* Pour rgba() */
            --fond-secondaire: #ffffff;
            --fond-tertiaire: #e9ecef;
            --texte-couleur: #212529;
            --texte-secondaire: rgba(0, 0, 0, 0.7);
            --texte-mute: rgba(0, 0, 0, 0.5);
            --bordure-couleur: rgba(0, 0, 0, 0.1);
            --ombre-couleur: rgba(0, 0, 0, 0.1);
            --logo-image: url('{{ asset("images/logov2/Logosfnoir.png") }}');

            /* --- Variables Bootstrap (Clair) --- */
            --bs-body-color: var(--texte-couleur); /* CORRIGÉ */
            --bs-body-bg: var(--fond-primaire);
            --bs-link-color: var(--violet-principal);
            --bs-link-hover-color: var(--violet-secondaire);
            --bs-border-color: var(--bordure-couleur);
            --bs-light-rgb: 33, 37, 41; /* Texte foncé */
            --bs-dark-rgb: 248, 249, 250; /* Fond clair */
             /* Couleurs alertes BS déjà ok par défaut */
        }

        /* ============================================== */
        /* STYLES DE BASE & BODY                 */
        /* ============================================== */
        body {
            background-color: var(--fond-primaire);
            color: var(--texte-couleur);
            font-family: 'Inter', sans-serif;
            transition: background-color 0.3s ease, color 0.3s ease;
        }
        main { min-height: calc(100vh - 150px - 200px); } /* Approx header/footer height */

        /* ============================================== */
        /* HEADER & NAVBAR                       */
        /* ============================================== */
        .site-header {
            background-color: rgba(var(--fond-primaire-rgb), 0.8); /* Adapte fond initial au thème */
            backdrop-filter: blur(8px);
            transition: background-color 0.3s ease, box-shadow 0.3s ease;
            position: sticky;
            top: 0;
            z-index: 1030;
        }
        .site-header.header-scrolled {
            background-color: var(--fond-secondaire);
            box-shadow: 0 2px 10px var(--ombre-couleur);
        }
        .navbar { transition: background-color 0.3s ease; }

        /* Styles Navbar basés sur thème (appliqués par le JS via classe sur body) */
        body.light-theme .navbar { /* Navbar claire */
            --bs-navbar-color: var(--texte-secondaire);
            --bs-navbar-hover-color: var(--texte-couleur);
            --bs-navbar-active-color: var(--violet-principal);
            --bs-navbar-toggler-border-color: var(--bordure-couleur);
            --bs-navbar-toggler-icon-bg: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba(33, 37, 41, 0.7)' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
        }
        body:not(.light-theme) .navbar { /* Navbar sombre */
            --bs-navbar-color: var(--texte-secondaire);
            --bs-navbar-hover-color: var(--texte-couleur);
            --bs-navbar-active-color: var(--violet-accent);
            --bs-navbar-toggler-border-color: var(--bordure-couleur);
            --bs-navbar-toggler-icon-bg: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba(255, 255, 255, 0.7)' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
        }
        .navbar-brand .logo-img {
            height: 35px;
            transition: transform 0.3s ease;
        }
        .navbar-brand:hover .logo-img { transform: scale(1.05); }

        /* ============================================== */
        /* DROPDOWNS (Normal & Megamenu)         */
        /* ============================================== */
        .dropdown-menu {
            background-color: var(--fond-secondaire);
            border: 1px solid var(--bordure-couleur);
            box-shadow: 0 5px 15px var(--ombre-couleur);
            padding: 0.5rem 0;
            border-radius: 0.5rem;
            margin-top: 0.5rem; /* Petit espace sous le lien parent */
        }
        .dropdown-item {
            color: var(--texte-couleur);
            transition: background-color 0.2s ease, color 0.2s ease;
            padding: 0.5rem 1rem;
            font-size: 0.95rem;
            display: flex; /* Pour aligner icônes */
            align-items: center;
        }
        .dropdown-item i {
            color: var(--violet-accent);
            margin-right: 0.75rem;
            width: 18px;
            text-align: center;
            transition: color 0.2s ease;
        }
        .dropdown-item:hover, .dropdown-item:focus {
            background-color: rgba(var(--violet-principal-rgb), 0.1);
            color: var(--violet-principal);
        }
        .dropdown-item:hover i { color: var(--violet-principal); }
        .dropdown-divider { border-top: 1px solid var(--bordure-couleur); }

        /* --- Mega Menu Amélioré --- */
        .mega-menu {
            border-top: 3px solid var(--violet-principal);
            width: calc(100% - 2rem);
            left: 1rem;
            padding: 1.5rem 1rem;
            border-radius: 0 0 0.5rem 0.5rem;
        }
        
        /* Boutons d'accès rapide */
        .mega-menu-top-buttons {
            padding: 0.5rem 0;
        }
        
        /* Classe pour le texte violet */
        .text-purple {
            color: var(--violet-accent) !important;
        }
        .mega-menu .row { margin: 0 -0.75rem; } /* Ajuste gouttière row BS */
        .mega-menu .column {
            padding: 0 0.75rem;
            transition: background-color 0.3s ease;
            border-radius: 0.5rem;
            margin-bottom: 1rem;
        }
        .mega-menu .column:hover {
            background-color: rgba(var(--violet-principal-rgb), 0.05);
        }
        .mega-menu-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 1rem;
            padding-bottom: 0.75rem;
            border-bottom: 1px solid var(--bordure-couleur);
        }
        .mega-menu-header i {
            color: var(--violet-accent);
            font-size: 1.6rem;
            width: 30px;
            text-align: center;
        }
        .mega-menu-header i.fa-recycle { color: var(--success-color) !important; } /* Vert pour recycle */
        .mega-menu-header h6 {
            color: var(--texte-couleur);
            font-weight: 600;
            font-size: 1rem;
            margin-bottom: 0;
        }
        .mega-menu ul { list-style: none; padding: 0; margin: 0; }
        .mega-menu ul li a {
            color: var(--texte-secondaire);
            text-decoration: none;
            display: block;
            padding: 0.4rem 0.5rem;
            margin: 0 -0.5rem;
            border-radius: 0.3rem;
            font-size: 0.9rem;
            transition: color 0.2s ease, background-color 0.2s ease;
        }
        .mega-menu ul li a:hover {
            color: var(--violet-accent);
            background-color: rgba(var(--violet-principal-rgb), 0.1);
        }
        
        /* Sous-menus dans le mega menu */
        .mega-menu ul li.mega-submenu {
            position: relative;
        }
        
        .mega-menu ul li.mega-submenu > ul {
            padding-left: 1.2rem;
            margin-top: 0.2rem;
            margin-bottom: 0.5rem;
            border-left: 1px solid rgba(var(--violet-principal-rgb), 0.2);
            display: none;
        }
        
        .mega-menu ul li.mega-submenu:hover > ul {
            display: block;
        }
        
        .mega-menu ul li.mega-submenu > a:after {
            content: '\f105';
            font-family: 'Font Awesome 5 Free';
            font-weight: 900;
            margin-left: auto;
            opacity: 0.7;
            transition: transform 0.2s;
        }
        
        .mega-menu ul li.mega-submenu:hover > a:after {
            transform: rotate(90deg);
            opacity: 1;
        }
        
        /* Bannière inférieure */
        .mega-menu-banner {
            background-color: rgba(var(--violet-principal-rgb), 0.1);
            padding: 0.75rem 1rem;
            border-radius: 0.5rem;
            margin-top: 0.5rem;
            text-align: center;
        }
        
        .mega-menu-banner a {
            color: var(--violet-accent);
            text-decoration: none;
            font-weight: 500;
        }
        
        .mega-menu-banner a:hover {
            text-decoration: underline;
        }

        /* ============================================== */
        /* BOUTONS                               */
        /* ============================================== */
        .btn { transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.1s ease, box-shadow 0.2s ease; }
        .btn:hover { transform: translateY(-2px); }
        .btn:active { transform: translateY(0); }

        .btn-purple {
            background-color: var(--violet-principal);
            border-color: var(--violet-principal);
            color: var(--white); /* Toujours blanc */
            box-shadow: 0 2px 5px rgba(var(--violet-principal-rgb), 0.2);
        }
        .btn-purple:hover, .btn-purple:focus {
            background-color: var(--violet-secondaire);
            border-color: var(--violet-secondaire);
            color: var(--white);
            box-shadow: 0 4px 10px rgba(var(--violet-principal-rgb), 0.3);
        }
        .btn-outline-purple {
            color: var(--violet-accent);
            border-color: var(--violet-accent);
        }
        .btn-outline-purple:hover, .btn-outline-purple:focus {
            color: var(--texte-couleur);
            background-color: var(--violet-accent);
            border-color: var(--violet-accent);
        }
        .btn-outline-light {
            color: var(--texte-secondaire);
            border-color: var(--bordure-couleur);
        }
        .btn-outline-light:hover {
            color: var(--fond-secondaire); /* Texte contrasté */
            background-color: var(--texte-secondaire);
            border-color: var(--texte-secondaire);
        }
         /* Adapte btn-outline-danger pour thèmes */
         .btn-outline-danger {
            color: var(--danger-color);
            border-color: rgba(var(--bs-danger-rgb), 0.5);
         }
         .btn-outline-danger:hover {
             color: var(--white);
             background-color: var(--danger-color);
             border-color: var(--danger-color);
         }


        /* ============================================== */
        /* FORMULAIRES (Recherche, etc)          */
        /* ============================================== */
        .search-form .form-control {
            background-color: var(--fond-tertiaire);
            border: 1px solid var(--bordure-couleur);
            color: var(--texte-couleur);
            border-radius: 50px 0 0 50px;
            padding-left: 1rem;
            height: calc(1.5em + 0.75rem + 2px); /* Match button height */
        }
        .search-form .form-control::placeholder { color: var(--texte-mute); }
        .search-form .form-control:focus {
            background-color: var(--fond-tertiaire);
            border-color: var(--violet-principal);
            box-shadow: 0 0 0 0.2rem rgba(var(--violet-principal-rgb), 0.25);
            color: var(--texte-couleur);
        }
        .search-form .btn { border-radius: 0 50px 50px 0; }

        /* ============================================== */
        /* ICONES NAVBAR (Theme, Panier)         */
        /* ============================================== */
        .theme-toggle {
            cursor: pointer;
            padding: 0.375rem 0.75rem;
            color: var(--texte-secondaire);
            font-size: 1.2rem;
            transition: color 0.2s ease, transform 0.2s ease;
            margin-left: 0.5rem;
        }
        .theme-toggle:hover {
            color: var(--violet-accent);
            transform: rotate(15deg);
        }
        .cart-icon-container { position: relative; display: inline-block; }
        .cart-icon-container > i { font-size: 1.3rem; color: var(--texte-secondaire); transition: color 0.2s ease;}
        .nav-link:hover .cart-icon-container > i { color: var(--texte-couleur); }
        .cart-badge {
            position: absolute;
            top: -7px;
            right: -10px;
        }
        .cart-count, .fa-exclamation-triangle {
            background-color: var(--violet-accent);
            color: var(--fond-primaire);
            border-radius: 50%;
            font-size: 0.7rem;
            font-weight: bold;
            line-height: 1;
            border: 1px solid var(--fond-secondaire);
            display: flex;
            align-items: center;
            justify-content: center;
            min-width: 20px;
            height: 20px;
            padding: 0 0.45em;
            box-sizing: border-box;
            position: relative;
            z-index: 1031;
        }
        .fa-exclamation-triangle {
            font-size: 0.6rem;
            background-color: var(--danger-color);
        }

        /* ============================================== */
        /* FOOTER                                */
        /* ============================================== */
        .site-footer {
            background-color: var(--fond-secondaire);
            color: var(--texte-secondaire);
            padding: 3rem 0 1rem 0;
            margin-top: 3rem;
            border-top: 1px solid var(--bordure-couleur);
        }
        .footer-logo { height: 40px; margin-bottom: 1rem; }
        .footer-title {
            color: var(--texte-couleur);
            margin-bottom: 1rem;
            font-weight: 600;
            font-size: 1.1rem; /* Légèrement plus grand */
        }
        .footer-links { list-style: none; padding: 0; margin: 0; }
        .footer-links li { margin-bottom: 0.5rem; }
        .footer-links a {
            color: var(--texte-secondaire);
            text-decoration: none;
            transition: color 0.2s ease;
            font-size: 0.95rem;
        }
        .footer-links a:hover { color: var(--violet-accent); }
        .footer-links i {
            color: var(--violet-accent);
            width: 20px;
            text-align: center;
            margin-right: 0.5rem;
            opacity: 0.8; /* Subtil */
        }
         .footer-links a:hover i { opacity: 1; } /* Pleine opacité au survol */

        .social-icons a {
            color: var(--texte-secondaire);
            margin-right: 1rem;
            font-size: 1.2rem;
            transition: color 0.2s ease, transform 0.2s ease;
        }
        .social-icons a:last-child { margin-right: 0; }
        .social-icons a:hover {
            color: var(--violet-accent);
            transform: translateY(-2px); /* Léger lift */
        }
        .footer-bottom {
            border-top: 1px solid var(--bordure-couleur);
            padding-top: 1.5rem;
            margin-top: 2rem;
            text-align: center;
            font-size: 0.9rem;
            color: var(--texte-mute);
        }
        .footer-bottom-links a {
            color: var(--texte-mute);
            margin: 0 0.5rem;
            text-decoration: none;
            transition: color 0.2s ease;
        }
        .footer-bottom-links a:hover { color: var(--violet-accent); }

        /* ============================================== */
        /* UTILITAIRES & ANIMATIONS              */
        /* ============================================== */
        .text-muted { color: var(--texte-mute) !important; }
        .animate__animated { visibility: hidden; } /* Caché par défaut, révélé par JS */
        .animate__fadeInUp { animation-duration: 0.6s; }
        
        /* ============================================== */
        /* TOAST NOTIFICATIONS                   */
        /* ============================================== */
        .custom-toast {
            position: fixed;
            bottom: 20px;
            right: 20px;
            min-width: 280px;
            max-width: 350px;
            background-color: var(--fond-secondaire);
            color: var(--texte-couleur);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
            border-radius: 8px;
            z-index: 1060;
            overflow: hidden;
            padding: 0;
            border: 1px solid var(--bordure-couleur);
            transition: transform 0.3s ease, opacity 0.3s ease;
            opacity: 0;
            transform: translateY(20px);
            animation: toastFadeIn 0.3s ease forwards;
        }
        
        @keyframes toastFadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .custom-toast .toast-header {
            background-color: var(--fond-secondaire);
            color: var(--texte-couleur);
            border-bottom: 1px solid var(--bordure-couleur);
            padding: 0.75rem 1rem;
            display: flex;
            align-items: center;
        }
        
        .custom-toast .toast-body {
            padding: 0.75rem 1rem;
            color: var(--texte-couleur);
        }
        
        .success-toast .toast-header {
            border-left: 4px solid var(--success-color);
        }
        
        .error-toast .toast-header {
            border-left: 4px solid var(--danger-color);
        }
        
        .warning-toast .toast-header {
            border-left: 4px solid var(--warning-color);
        }
        
        .btn-close {
            background: transparent url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%23888'%3e%3cpath d='M.293.293a1 1 0 011.414 0L8 6.586 14.293.293a1 1 0 111.414 1.414L9.414 8l6.293 6.293a1 1 0 01-1.414 1.414L8 9.414l-6.293 6.293a1 1 0 01-1.414-1.414L6.586 8 .293 1.707a1 1 0 010-1.414z'/%3e%3c/svg%3e") center/0.8em auto no-repeat;
            opacity: 0.5;
            width: 1em;
            height: 1em;
            padding: 0;
            margin-left: auto;
            transition: opacity 0.2s ease;
        }
        
        .btn-close:hover {
            opacity: 0.8;
        }
        
        .light-theme .btn-close {
            filter: invert(1) grayscale(100%) brightness(80%);
        }

    </style>

    {% block head %}{% endblock %}
</head>
<body class="{% if initial_theme == 'light' %}light-theme{% endif %}">

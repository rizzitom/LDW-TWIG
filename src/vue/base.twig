    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // 1. Effet Header au Scroll
            const header = document.querySelector('.site-header');
            if (header) {
                 window.addEventListener('scroll', function() {
                    if (window.scrollY > 50) {
                        header.classList.add('header-scrolled');
                    } else {
                        header.classList.remove('header-scrolled');
                    }
                 });
            }

            // 2. Animations au Scroll (Intersection Observer)
            const animateElements = document.querySelectorAll('.animate__animated');
            if ("IntersectionObserver" in window && animateElements.length > 0) {
                 const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            const element = entry.target;
                            const delay = element.style.animationDelay ? parseFloat(element.style.animationDelay) * 1000 : 0;
                            setTimeout(() => {
                                 element.style.visibility = 'visible';
                                 // Retrouve le nom de l'animation (ex: animate__fadeInUp)
                                 const animationClass = Array.from(element.classList).find(cls => cls.startsWith('animate__') && cls !== 'animate__animated');
                                 if (animationClass) {
                                     element.classList.add(animationClass); // Ré-applique pour être sûr ? Ou juste visibilité
                                 }
                            }, delay);
                            observer.unobserve(element);
                        }
                    });
                 }, { threshold: 0.1 });

                 animateElements.forEach((element, index) => {
                     element.style.visibility = 'hidden'; // Cache
                     // Applique délai si non défini
                    if (!element.style.animationDelay) {
                         element.style.animationDelay = `${index * 0.05}s`;
                    }
                     observer.observe(element);
                 });
            } else {
                  animateElements.forEach(el => { el.style.visibility = 'visible'; }); // Fallback
            }

            // 3. Logique de Changement de Thème
            const themeToggle = document.getElementById('theme-toggle');
            const body = document.body;
            const themeIcon = themeToggle ? themeToggle.querySelector('i') : null;
            const logoHeader = document.getElementById('theme-logo-header');
            const logoFooter = document.getElementById('theme-logo-footer');
            // Utilise les variables CSS pour les chemins - plus propre si ça marche, sinon fallback JS
            // Note: Cette approche CSS directe ne fonctionne PAS pour <img src="">
            // Il faut utiliser JS comme ci-dessous.
             const logoPathLight = '{{ asset("images/logov2/Logosfnoir.png") }}';
             const logoPathDark = '{{ asset("images/logov2/Logosfblanc.png") }}';


             // Fonction pour appliquer le thème
             function applyTheme(theme, initialLoad = false) {
                // Applique la classe au body
                body.classList.toggle('light-theme', theme === 'light');

                // Met à jour l'icône du bouton
                 if (themeIcon) {
                     themeIcon.className = theme === 'light' ? 'fas fa-moon' : 'fas fa-sun';
                 }

                 // Met à jour la source des logos
                 if (logoHeader) {
                    logoHeader.src = theme === 'light' ? logoPathLight : logoPathDark;
                    if(!initialLoad) logoHeader.style.opacity = 0; // Effet fondu
                 }
                 if (logoFooter) {
                    logoFooter.src = theme === 'light' ? logoPathLight : logoPathDark;
                     if(!initialLoad) logoFooter.style.opacity = 0; // Effet fondu
                 }

                 // Effet fondu pour les logos (optionnel)
                 if(!initialLoad) {
                    setTimeout(() => {
                        if(logoHeader) logoHeader.style.transition = 'opacity 0.3s ease';
                        if(logoFooter) logoFooter.style.transition = 'opacity 0.3s ease';
                        if(logoHeader) logoHeader.style.opacity = 1;
                        if(logoFooter) logoFooter.style.opacity = 1;
                    }, 50); // Petit délai pour que le changement de src soit pris en compte
                 }
             }

            // Récupère le thème sauvegardé ou utilise le thème système/défaut
             let currentTheme = localStorage.getItem('theme');
             if (!currentTheme) {
                 // Préférence système (optionnel, fallback sombre si non supporté)
                 // currentTheme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
                 currentTheme = 'dark'; // Ou forcer sombre par défaut si pas de préférence système
             }

             // Applique le thème initial au chargement (sans transition logo)
             applyTheme(currentTheme, true);

             // Listener pour le bouton de changement de thème
             if (themeToggle) {
                  themeToggle.addEventListener('click', () => {
                     currentTheme = body.classList.contains('light-theme') ? 'dark' : 'light';
                     localStorage.setItem('theme', currentTheme);
                     applyTheme(currentTheme); // Applique avec transition logo
                  });
             }
             
             // 4. Gestion Méga Menu amélioré pour mobile
             const handleMegaSubmenuMobile = () => {
                 // Ne s'applique qu'en mode mobile
                 if (window.innerWidth < 992) {
                     const megaSubmenuItems = document.querySelectorAll('.mega-menu ul li.mega-submenu > a');
                     
                     megaSubmenuItems.forEach(item => {
                         item.addEventListener('click', function(e) {
                             // Empêche la navigation uniquement si le clic est sur le lien parent
                             // et pas un élément enfant
                             if (e.currentTarget === e.target || e.target.tagName === 'I') {
                                 e.preventDefault();
                                 
                                 // Trouve la liste imbriquée associée
                                 const submenu = this.nextElementSibling;
                                 if (submenu && submenu.tagName === 'UL') {
                                     // Toggle l'affichage
                                     const isVisible = submenu.style.display === 'block';
                                     submenu.style.display = isVisible ? 'none' : 'block';
                                     
                                     // Rotation de la flèche
                                     const arrow = this.querySelector('::after');
                                     if (arrow) {
                                         this.classList.toggle('submenu-open', !isVisible);
                                     }
                                 }
                             }
                         });
                     });
                 }
             };
             
             // Applique au chargement et au redimensionnement
             handleMegaSubmenuMobile();
             window.addEventListener('resize', handleMegaSubmenuMobile);

        }); // Fin DOMContentLoaded
    </script>

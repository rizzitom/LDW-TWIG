                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="index.php?page=produit"><i class="fas fa-box me-2"></i> Gestion Produits</a></li>
                                    <li><a class="dropdown-item" href="index.php?page=type"><i class="fas fa-tags me-2"></i> Gestion Catégories</a></li>
                                    <li><a class="dropdown-item" href="index.php?page=utilisateurs"><i class="fas fa-users-cog me-2"></i> Gestion Utilisateurs</a></li>
                                </ul>
                            </li>
                        {% endif %}

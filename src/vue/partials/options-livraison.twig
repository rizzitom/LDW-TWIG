{# Options de livraison simplifiées - Ne contient que la livraison à domicile #}
<div class="delivery-options-container mt-4 mb-4 p-4 border rounded shadow-sm text-center">
    <h3 class="section-title mb-4 font-weight-bold text-primary text-center">
        <i class="fas fa-shipping-fast me-2"></i>Mode de livraison
    </h3>

    <div class="delivery-options d-flex justify-content-center">
        <div class="delivery-option selected" data-option="domicile">
            <div class="card h-100 delivery-option-card">
                <div class="card-header bg-white border-0 pt-3 pb-0">
                    <div class="d-flex align-items-center delivery-option-header">
                        <div class="form-check me-3">
                            <input class="form-check-input" type="radio" name="mode_livraison" id="option-domicile" value="domicile" checked required>
                            <label class="form-check-label" for="option-domicile"></label>
                        </div>
                        <div class="delivery-option-icon text-success me-3">
                            <i class="fas fa-truck fa-2x"></i>
                        </div>
                        <div class="delivery-option-details flex-grow-1">
                            <h4 class="mb-0">Livraison à domicile</h4>
                            <p class="text-muted small mb-0">Livraison standard à votre adresse</p>
                        </div>
                        <div class="delivery-option-price ms-auto text-end">
                            <span class="fs-5 fw-bold text-success">
                                {% set home_price = panier.frais_livraison|default(6.90) %}
                                {% if home_price == 0 %}Gratuit{% else %}{{ home_price|number_format(2, ',', ' ') }} €{% endif %}
                            </span>
                        </div>
                    </div>
                </div>
                <div class="card-body delivery-option-body show">
                    <p class="small">Votre commande sera livrée directement à l'adresse que vous avez indiquée.</p>
                    <ul class="list-unstyled delivery-features small">
                        <li class="mb-1"><i class="fas fa-check text-success me-2"></i>Livraison sous 2-3 jours ouvrés</li>
                        <li class="mb-1"><i class="fas fa-check text-success me-2"></i>Suivi de colis disponible</li>
                        <li class="mb-1"><i class="fas fa-info-circle text-info me-2"></i>Livraison gratuite pour les commandes de plus de 50€</li>
                    </ul>
                    
                    {# Aucun input hidden nécessaire car le radio button est déjà présent #}
                </div>
            </div>
        </div>
    </div>
</div>

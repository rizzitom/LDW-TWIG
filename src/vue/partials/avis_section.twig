<div class="customer-reviews-content">
    {% if avis|default([])|length > 0 %}
        <div class="reviews-container">
            {% for review in avis %}
            <div class="review-card animate__animated animate__fadeInUp" style="animation-delay: {{ loop.index0 * 0.1 }}s">
                <div class="review-header">
                    <div class="review-user">
                        <i class="fas fa-user-circle review-avatar"></i>
                        <div>
                            <h4 class="review-name">{{ review.nom }}</h4>
                            <div class="review-date">{{ review.date|date("d/m/Y") }}</div>
                        </div>
                    </div>
                    <div class="review-rating">
                        {% for i in 1..5 %}<i class="{{ i <= review.note ? 'fas' : 'far' }} fa-star"></i>{% endfor %}
                    </div>
                </div>
                <div class="review-content">
                    <p>{{ review.commentaire }}</p>
                </div>
            </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="empty-reviews">
            <i class="far fa-comment-dots empty-icon"></i>
            <h3>Aucun avis pour l'instant</h3>
            <p>Soyez le premier à partager votre expérience avec ce produit !</p>
        </div>
    {% endif %}

    <div class="review-form-container mt-4 pt-4 border-top">
        <h3>Donnez votre avis</h3>
        <form action="index.php?page=produit&action=avis&id={{ produit_id }}" method="post">
            <div class="mb-3">
                <label for="reviewNom" class="form-label">Votre nom <span class="text-danger">*</span></label>
                <input type="text" class="form-control" id="reviewNom" name="nom" required>
            </div>
            <div class="mb-3">
                <label class="form-label">Votre note <span class="text-danger">*</span></label>
                <div class="rating-selector">
                    <div class="stars">
                        {# Note: Les ID doivent être uniques sur la page globale si ce partiel est réutilisé #}
                        {% for i in 5..1 %}{# Inverse l'ordre pour le CSS trick #}
                        <input type="radio" id="star{{ produit_id }}-{{ i }}" name="note" value="{{ i }}" required>
                        <label for="star{{ produit_id }}-{{ i }}" title="{{ i }} étoile{{ i > 1 ? 's' : '' }}"><i class="far fa-star"></i></label>
                        {% endfor %}
                    </div>
                </div>
            </div>
            <div class="mb-3">
                <label for="reviewCommentaire" class="form-label">Votre avis <span class="text-danger">*</span></label>
                <textarea class="form-control" id="reviewCommentaire" name="commentaire" rows="4" required></textarea>
            </div>
            <button type="submit" class="btn btn-purple"> <i class="fas fa-paper-plane me-2"></i> Soumettre mon avis</button>
        </form>
    </div>
</div>

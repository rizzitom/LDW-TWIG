{% extends "base.twig" %}

{% block title %}Confirmation de commande - Le Design Du Web{% endblock %}

{% block head %}
<style>
    /* Styles améliorés pour la page de confirmation */
    .confirmation-container {
        background-color: var(--fond-secondaire);
        border-radius: 15px;
        padding: 2.5rem;
        margin-bottom: 2rem;
        text-align: center;
        border: 1px solid var(--bordure-couleur);
        box-shadow: 0 5px 25px var(--ombre-couleur);
        animation: fadeInUp 0.8s ease;
    }
    
    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    .confirmation-icon {
        font-size: 5.5rem;
        color: var(--violet-principal);
        margin-bottom: 1.5rem;
        animation: pulse 2s infinite;
    }
    
    @keyframes pulse {
        0% {
            transform: scale(1);
        }
        50% {
            transform: scale(1.1);
        }
        100% {
            transform: scale(1);
        }
    }
    
    .confirmation-reference {
        font-size: 1.3rem;
        background-color: var(--fond-tertiaire);
        padding: 1.2rem;
        border-radius: 12px;
        margin: 1.8rem auto;
        font-family: monospace;
        letter-spacing: 1px;
        display: inline-block;
        min-width: 300px;
        border: 1px solid var(--bordure-couleur);
        box-shadow: 0 3px 15px rgba(0,0,0,0.1);
    }
    
    .order-details {
        background-color: var(--fond-tertiaire);
        border-radius: 12px;
        padding: 2rem;
        margin-top: 2.5rem;
        text-align: left;
        border: 1px solid var(--bordure-couleur);
        box-shadow: 0 3px 15px rgba(0,0,0,0.1);
    }
    
    .order-details-title {
        border-bottom: 1px solid #6200b3;
        padding-bottom: 0.5rem;
        margin-bottom: 1rem;
    }
    
    .order-item {
        display: flex;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #444;
    }
    
    .order-item:last-child {
        border-bottom: none;
        margin-bottom: 0;
        padding-bottom: 0;
    }
    
    .order-item-image {
        width: 60px;
        height: 60px;
        background-size: contain;
        background-position: center;
        background-repeat: no-repeat;
        border-radius: 5px;
        margin-right: 1rem;
    }
    
    .order-item-details {
        flex-grow: 1;
    }
    
    .order-item-price {
        font-weight: bold;
        color: #6200b3;
    }
    
    .order-summary {
        margin-top: 1.5rem;
    }
    
    .order-summary-row {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.5rem;
    }
    
    .order-summary-total {
        font-size: 1.5rem;
        font-weight: bold;
        border-top: 1px solid #6200b3;
        padding-top: 1rem;
        margin-top: 1rem;
    }
    
    .shipping-info {
        margin-top: 2rem;
    }
    
    /* Utilisation du même indicateur de progression amélioré */
    .step-indicator {
        display: flex;
        justify-content: space-between;
        margin-bottom: 3rem;
        position: relative;
        padding: 0 10px;
    }
    
    .step-indicator::before {
        content: "";
        position: absolute;
        top: 35px;
        left: 0;
        right: 0;
        height: 4px;
        background-color: var(--bordure-couleur);
        z-index: 1;
    }
    
    .step-progress {
        position: absolute;
        top: 35px;
        left: 0;
        height: 4px;
        background: linear-gradient(90deg, var(--violet-principal), var(--violet-secondaire));
        z-index: 2;
        transition: width 0.5s ease;
        border-radius: 2px;
        width: 100%; /* Complété */
    }
    
    .step {
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        flex: 1;
        z-index: 3;
    }
    
    .step-icon {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        background-color: var(--violet-secondaire);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 15px;
        border: 2px solid var(--violet-secondaire);
        position: relative;
        transition: all 0.3s ease;
        box-shadow: 0 4px 10px var(--ombre-couleur);
    }
    
    .step.active .step-icon {
        background-color: var(--violet-principal);
        color: white;
        border-color: var(--violet-principal);
        transform: scale(1.1);
        box-shadow: 0 0 0 5px rgba(var(--violet-principal-rgb), 0.2);
    }
    
    .step .step-icon::after {
        content: "\f00c";
        font-family: "Font Awesome 5 Free";
        font-weight: 900;
        position: absolute;
        bottom: -5px;
        right: -5px;
        background-color: #4CAF50;
        color: white;
        border-radius: 50%;
        width: 25px;
        height: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.8rem;
        border: 2px solid var(--fond-secondaire);
    }
    
    .step-label {
        font-size: 1rem;
        color: var(--texte-secondaire);
        font-weight: 500;
        text-align: center;
        transition: all 0.3s ease;
    }
    
    .step.active .step-label {
        color: var(--violet-principal);
        font-weight: bold;
    }
    
    /* Styles supplémentaires pour la page de confirmation */
    .success-message {
        margin-bottom: 1.5rem;
        color: var(--texte-blanc);
    }
    
    .success-message h1 {
        font-size: 2.2rem;
        font-weight: 700;
        margin-bottom: 1rem;
    }
    
    .success-message p {
        font-size: 1.1rem;
        opacity: 0.9;
    }
    
    .order-status {
        display: inline-block;
        background-color: rgba(var(--violet-principal-rgb), 0.1);
        color: var(--violet-principal);
        padding: 0.5rem 1rem;
        border-radius: 30px;
        font-weight: 500;
        margin-bottom: 1.5rem;
        border: 1px solid rgba(var(--violet-principal-rgb), 0.2);
    }
    
    .payment-confirmation {
        animation: fadeIn 1s ease;
    }
    
    .payment-badge {
        box-shadow: 0 3px 10px rgba(0, 128, 0, 0.3);
        font-weight: 600;
        letter-spacing: 0.5px;
        animation: pulse 2s infinite;
    }
    
    @keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }
</style>
{% endblock %}

{% block body %}
<div class="container mt-5">
    {# Indicateur de progression amélioré #}
    <div class="step-indicator">
        <div class="step-progress"></div>
        
        <div class="step completed">
            <div class="step-icon">
                <i class="fas fa-shopping-cart"></i>
            </div>
            <div class="step-label">Panier</div>
        </div>
        
        <div class="step completed">
            <div class="step-icon">
                <i class="fas fa-truck"></i>
            </div>
            <div class="step-label">Livraison</div>
        </div>
        
        <div class="step completed">
            <div class="step-icon">
                <i class="fas fa-credit-card"></i>
            </div>
            <div class="step-label">Paiement</div>
        </div>
        
        <div class="step active completed">
            <div class="step-icon">
                <i class="fas fa-check"></i>
            </div>
            <div class="step-label">Confirmation</div>
        </div>
    </div>
    
    <div class="confirmation-container">
        <div class="confirmation-icon">
            <i class="fas fa-check-circle"></i>
        </div>
        
        <div class="success-message">
            <h1>Commande confirmée !</h1>
            <p class="lead">Merci pour votre commande. Nous vous tiendrons informé de son avancement.</p>
            <p>Un email de confirmation a été envoyé à l'adresse <strong>{{ commande.email }}</strong></p>
        </div>
        
        <div class="order-status">
            <i class="fas fa-circle-notch me-2"></i> En préparation
        </div>
        
        <div class="payment-confirmation mt-3 mb-4">
            <div class="payment-badge bg-success text-white py-2 px-4 rounded-pill d-inline-flex align-items-center">
                <i class="fas fa-shield-alt me-2"></i> Paiement sécurisé confirmé
            </div>
        </div>
        
        <div class="confirmation-reference">
            Référence de commande : {{ commande.reference }}
        </div>
        
        <p>Un email de confirmation a été envoyé à l'adresse <strong>{{ commande.email }}</strong></p>
        
        {% if commande.produits|length > 0 %}
        <div class="order-details">
            <h3 class="order-details-title mb-4">Détails de la commande</h3>
            
            {% for produit in commande.produits %}
            <div class="order-item">
                <div class="order-item-image" style="background-image: url('{{ produit.image_url }}')"></div>
                <div class="order-item-details">
                    <h6 class="mb-1">{{ produit.nom }}</h6>
                    <div class="d-flex justify-content-between">
                        <span>{{ produit.quantite }} x {{ produit.prix_unitaire }} €</span>
                        <span class="order-item-price">{{ produit.quantite * produit.prix_unitaire }} €</span>
                    </div>
                </div>
            </div>
            {% endfor %}
            
            <div class="order-summary">
                <div class="order-summary-row">
                    <span>Sous-total</span>
                    <span>{{ commande.montant_total }} €</span>
                </div>
                
                <div class="order-summary-row">
                    <span>Frais de livraison</span>
                    <span>Gratuit</span>
                </div>
                
                <div class="order-summary-row order-summary-total">
                    <span>Total</span>
                    <span>{{ commande.montant_total }} €</span>
                </div>
            </div>
            
            <div class="shipping-info mt-4">
                <h4 class="mb-3">Informations de livraison</h4>
                
                <div class="p-3 bg-dark rounded mb-4">
                    <div class="d-flex align-items-start">
                        <div class="me-3">
                            <i class="fas fa-home text-success fs-4"></i>
                        </div>
                        <div>
                            <h5 class="text-success mb-2">Livraison à domicile</h5>
                            <p class="mb-0">{{ commande.adresse_livraison|nl2br }}</p>
                            
                            {% if commande.instructions_livraison %}
                            <div class="mt-3 pt-3 border-top border-secondary">
                                <p class="mb-0 fst-italic">
                                    <i class="fas fa-info-circle me-2 text-warning"></i>
                                    Instructions: {{ commande.instructions_livraison }}
                                </p>
                            </div>
                            {% endif %}
                            
                            <div class="mt-3 text-info small">
                                <i class="fas fa-info-circle me-1"></i> 
                                Votre commande sera livrée sous 2-3 jours ouvrés à l'adresse indiquée.
                            </div>
                        </div>
                    </div>
                </div>
                
                <h4 class="mb-3">Méthode de paiement</h4>
                {% if commande.methode_paiement == 'carte' %}
                <div class="payment-info">
                    <p>
                        <i class="far fa-credit-card me-2 text-purple"></i> Paiement par carte bancaire via Stripe
                        {% if paiement %}
                            <span class="badge bg-success ms-2">Paiement confirmé</span>
                        {% endif %}
                    </p>
                    {% if paiement %}
                    <div class="payment-details mt-3 p-3 bg-dark rounded">
                        <div class="payment-detail-row">
                            <span class="payment-label">Statut:</span>
                            <span class="payment-value">{{ paiement.statut }}</span>
                        </div>
                        <div class="payment-detail-row">
                            <span class="payment-label">Transaction ID:</span>
                            <span class="payment-value">{{ paiement.payment_intent_id }}</span>
                        </div>
                        <div class="payment-detail-row">
                            <span class="payment-label">Date:</span>
                            <span class="payment-value">{{ paiement.date_paiement|date('d/m/Y H:i') }}</span>
                        </div>
                    </div>
                    {% endif %}
                </div>
                {% else %}
                <p>{{ commande.methode_paiement|capitalize }}</p>
                {% endif %}
            </div>
        </div>
        {% endif %}
        
        <div class="mt-4">
            <a href="index.php?page=commande&id={{ commande.id }}&action=facture" class="btn btn-primary me-3">
                <i class="fas fa-file-invoice me-2"></i> Télécharger la facture
            </a>
            <a href="index.php?page=boutique" class="btn btn-purple btn-lg">
                <i class="fas fa-shopping-bag me-2"></i> Continuer mes achats
            </a>
        </div>
    </div>
</div>
{% endblock %}

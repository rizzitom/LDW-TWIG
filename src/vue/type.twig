{% extends 'admin/base-admin.twig' %}

{% block admin_title %}Gestion des Catégories{% endblock %}

{% block admin_actions %}
<button type="button" class="btn btn-purple" data-bs-toggle="modal" data-bs-target="#ajouterTypeModal">
    <i class="fas fa-plus me-2"></i> Ajouter une catégorie
</button>
{% endblock %}

{% block admin_content %}
    <div class="table-responsive admin-table">
        <table class="table table-dark table-hover">
            <thead>
                <tr>
                    <th scope="col">Nom de la catégorie</th>
                    <th scope="col" style="width: 180px">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for type in types %}
                    <tr>
                        <td>{{ type.nom }}</td>
                        <td>
                            <div class="d-flex gap-2">
                                <!-- Modifier -->
                                <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#modalModifier{{ type.id }}">
                                    <i class="fas fa-edit"></i>
                                </button>
                                
                                <!-- Supprimer -->
                                <a href="index.php?page=type&action=supprimer&id={{ type.id }}" class="btn btn-sm btn-outline-danger" 
                                   onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette catégorie ?')">
                                    <i class="fas fa-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                
                {% if types|length == 0 %}
                    <tr>
                        <td colspan="2" class="text-center py-4">
                            <i class="fas fa-tags fa-3x mb-3 text-muted"></i>
                            <p>Aucune catégorie trouvée</p>
                        </td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
    </div>
{% endblock %}

{% block admin_modals %}
    <!-- Modals de modification pour chaque catégorie -->
    {% for type in types %}
        <div class="modal fade modal-admin" id="modalModifier{{ type.id }}" tabindex="-1" aria-labelledby="modalModifierLabel{{ type.id }}" aria-hidden="true">
            <div class="modal-dialog">
                <form method="post">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="modalModifierLabel{{ type.id }}">Modifier la catégorie</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label for="inputNomType{{ type.id }}" class="form-label">Nom de la catégorie</label>
                                <input type="text" id="inputNomType{{ type.id }}" name="inputNomType" class="form-control" value="{{ type.nom }}" required>
                                <input type="hidden" name="typeId" value="{{ type.id }}">
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Annuler</button>
                            <button type="submit" name="btModifierType" class="btn btn-purple">Enregistrer</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    {% endfor %}

    <!-- Modal d'ajout -->
    <div class="modal fade modal-admin" id="ajouterTypeModal" tabindex="-1" aria-labelledby="ajouterTypeModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <form method="post">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="ajouterTypeModalLabel">Ajouter une catégorie</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label for="inputNomType" class="form-label">Nom de la catégorie</label>
                            <input type="text" id="inputNomType" name="inputNomType" class="form-control" required>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" name="btAjouterType" class="btn btn-purple">Ajouter</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
